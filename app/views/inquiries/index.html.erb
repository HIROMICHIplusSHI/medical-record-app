<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">お問い合わせ一覧</h1>
    <%= link_to "新規お問い合わせ", new_inquiry_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <% if @inquiries.any? %>
    <div class="bg-white shadow-md rounded">
      <table class="min-w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-16">未読</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">件名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">カテゴリ</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ステータス</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">更新日時</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @inquiries.each do |inquiry| %>
            <tr>
              <td class="px-3 py-4 text-center">
                <%= unread_indicator_for(inquiry, current_user) %>
              </td>
              <td class="px-6 py-4">
                <%= link_to inquiry.subject, inquiry_path(inquiry), class: "text-blue-600 hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-800">
                  <%= inquiry.category_i18n %>
                </span>
              </td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= inquiry.open? ? 'bg-blue-100 text-blue-800' : inquiry.in_progress? ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= inquiry.status_i18n %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500">
                <%= l(inquiry.updated_at, format: :short) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= link_to "表示", inquiry_path(inquiry), class: "text-blue-600 hover:text-blue-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex justify-center">
      <%= paginate @inquiries %>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded p-8 text-center">
      <p class="text-gray-600 mb-4">まだお問い合わせはありません。</p>
      <%= link_to "最初のお問い合わせを作成する", new_inquiry_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  <% end %>
</div>
