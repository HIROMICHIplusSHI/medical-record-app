<div class="py-6 sm:py-8">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">お問い合わせ一覧</h1>
    <div><%= new_button "新規お問い合わせ", new_inquiry_path %></div>
  </div>

  <% if @inquiries.any? %>
    <!-- スマホ・タブレット: カード表示（タブレットは2カラム） -->
    <div class="lg:hidden space-y-3 md:space-y-0 md:grid md:grid-cols-2 md:gap-3">
      <% @inquiries.each do |inquiry| %>
        <div class="bg-white shadow-sm border border-greige-200 rounded-lg p-4 flex flex-col">
          <div class="flex items-start gap-2">
            <span class="shrink-0 mt-1"><%= unread_indicator_for(inquiry, current_user) %></span>
            <%= link_to inquiry.subject, inquiry_path(inquiry), class: "text-base font-semibold text-accent-primary hover:text-accent-primary/80 transition-colors break-words" %>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="px-2 py-1 text-xs font-medium rounded-full bg-greige-100 text-greige-800">
              <%= inquiry.category_i18n %>
            </span>
            <span class="px-2 py-1 text-xs font-medium rounded-full <%= inquiry.open? ? 'bg-blue-100 text-blue-800' : inquiry.in_progress? ? 'bg-accent-warning/10 text-accent-warning/90' : 'bg-greige-100 text-greige-800' %>">
              <%= inquiry.status_i18n %>
            </span>
            <span class="text-xs text-greige-500"><%= l(inquiry.updated_at, format: :short) %></span>
          </div>
          <div class="mt-4 md:mt-auto md:pt-4">
            <%= show_button "表示", inquiry_path(inquiry) %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- デスクトップ(lg以上): テーブル表示 -->
    <div class="hidden lg:block bg-white shadow-md rounded overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-greige-50">
          <tr>
            <th class="px-3 py-3 text-center text-xs font-medium text-greige-500 uppercase tracking-wider w-16">未読</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">件名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">カテゴリ</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">ステータス</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">更新日時</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-greige-200">
          <% @inquiries.each do |inquiry| %>
            <tr>
              <td class="px-3 py-4 text-center">
                <%= unread_indicator_for(inquiry, current_user) %>
              </td>
              <td class="px-6 py-4">
                <%= link_to inquiry.subject, inquiry_path(inquiry), class: "text-accent-primary hover:text-accent-primary/80 transition-colors" %>
              </td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 text-xs font-medium rounded-full bg-greige-100 text-greige-800">
                  <%= inquiry.category_i18n %>
                </span>
              </td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= inquiry.open? ? 'bg-blue-100 text-blue-800' : inquiry.in_progress? ? 'bg-accent-warning/10 text-accent-warning/90' : 'bg-greige-100 text-greige-800' %>">
                  <%= inquiry.status_i18n %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-greige-500 whitespace-nowrap">
                <%= l(inquiry.updated_at, format: :short) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= show_button "表示", inquiry_path(inquiry) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex justify-center">
      <%= paginate @inquiries %>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded p-8 text-center">
      <p class="text-greige-600 mb-4">まだお問い合わせはありません。</p>
      <%= new_button "最初のお問い合わせを作成する", new_inquiry_path %>
    </div>
  <% end %>
</div>
