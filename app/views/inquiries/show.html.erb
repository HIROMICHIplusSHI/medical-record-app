<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">お問い合わせ詳細</h1>
    <%= link_to "一覧に戻る", inquiries_path, class: "bg-greige-500 hover:bg-greige-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <div class="bg-white shadow-md rounded p-6 mb-6">
    <dl class="grid grid-cols-1 gap-6">
      <div>
        <dt class="text-sm font-medium text-greige-500">件名</dt>
        <dd class="mt-1 text-lg text-greige-900"><%= @inquiry.subject %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-greige-500">カテゴリ</dt>
        <dd class="mt-1">
          <span class="px-2 py-1 text-sm font-medium rounded-full bg-greige-100 text-greige-800">
            <%= @inquiry.category_i18n %>
          </span>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-greige-500">ステータス</dt>
        <dd class="mt-1">
          <span class="px-2 py-1 text-sm font-medium rounded-full <%= @inquiry.open? ? 'bg-blue-100 text-blue-800' : @inquiry.in_progress? ? 'bg-accent-warning/10 text-accent-warning/90' : 'bg-greige-100 text-greige-800' %>">
            <%= @inquiry.status_i18n %>
          </span>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-greige-500">作成日時</dt>
        <dd class="mt-1 text-lg text-greige-900"><%= l(@inquiry.created_at, format: :long) %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-greige-500">最終更新日時</dt>
        <dd class="mt-1 text-lg text-greige-900"><%= l(@inquiry.updated_at, format: :long) %></dd>
      </div>
    </dl>
  </div>

  <div class="bg-white shadow-md rounded p-6 mb-6">
    <h2 class="text-xl font-bold text-greige-900 mb-4">メッセージ履歴</h2>
    <div class="space-y-4">
      <% @inquiry_messages.each do |message| %>
        <div class="<%= message.user.admin? ? 'bg-blue-50 border-l-4 border-blue-500' : 'bg-greige-50 border-l-4 border-greige-300' %> p-4 rounded">
          <div class="flex justify-between items-center mb-2">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-greige-900"><%= message.user.name %></span>
              <% if message.user.admin? %>
                <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">管理者</span>
              <% end %>
            </div>
            <span class="text-sm text-greige-500">
              <%= l(message.created_at, format: :short) %>
            </span>
          </div>
          <div class="text-greige-700 whitespace-pre-wrap"><%= message.body %></div>
        </div>
      <% end %>
    </div>
  </div>

  <% unless @inquiry.closed? %>
    <div class="bg-white shadow-md rounded p-6">
      <h3 class="text-xl font-bold text-greige-900 mb-4">返信する</h3>
      <%= form_with model: [@inquiry, @inquiry_message], local: true, class: 'space-y-4' do |f| %>
        <% if @inquiry_message.errors.any? %>
          <div class="bg-accent-danger/10 border border-accent-danger text-accent-danger px-4 py-3 rounded">
            <ul class="list-disc list-inside text-sm">
              <% @inquiry_message.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :body, '本文', class: 'block text-sm font-medium text-greige-700 mb-2' %>
          <%= f.text_area :body, rows: 5, class: 'mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary', placeholder: '返信内容を入力してください' %>
        </div>

        <div class="flex justify-end">
          <%= f.submit '送信', class: 'bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded' %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-blue-100 border border-blue-400 text-accent-primary/90 px-4 py-3 rounded">
      <p>このお問い合わせは閉じられています。</p>
    </div>
  <% end %>
</div>
