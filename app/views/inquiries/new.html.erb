<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <div class="mb-6">
      <%= link_to inquiries_path, class: 'text-blue-600 hover:text-blue-800 inline-flex items-center' do %>
        <span aria-hidden="true">← </span>
        <span>一覧に戻る</span>
      <% end %>
    </div>

    <h1 class="text-3xl font-bold text-gray-900 mb-2">新規お問い合わせ</h1>
    <p class="text-sm text-gray-600 mb-6">
      お困りのことやご不明な点がございましたら、お気軽にお問い合わせください。
      管理者が確認次第、できるだけ早くご返信いたします。
    </p>

    <div class="bg-white shadow-md rounded p-6">
      <%= form_with model: @inquiry, local: true, class: 'space-y-6' do |f| %>
        <% if @inquiry.errors.any? %>
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
            <h3 class="font-bold mb-2">入力内容にエラーがあります</h3>
            <ul class="list-disc list-inside text-sm">
              <% @inquiry.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :category, class: 'block text-sm font-medium text-gray-700 mb-2' do %>
            カテゴリ <span class="text-red-600">*</span>
          <% end %>
          <p class="text-xs text-gray-500 mb-2">お問い合わせの種類を選択してください</p>
          <%= f.select :category,
            options_for_select(
              Inquiry.categories.keys.map { |key| [I18n.t("activerecord.attributes.inquiry.categories.#{key}"), key] },
              @inquiry.category
            ),
            { prompt: 'カテゴリを選択してください' },
            { class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500', data: { controller: 'tom-select' } } %>
        </div>

        <div>
          <%= f.label :subject, class: 'block text-sm font-medium text-gray-700 mb-2' do %>
            件名 <span class="text-red-600">*</span>
          <% end %>
          <p class="text-xs text-gray-500 mb-2">お問い合わせの内容を簡潔にご入力ください（最大100文字）</p>
          <%= f.text_field :subject, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500', placeholder: '例: ログインできない、機能の使い方について', maxlength: 100 %>
        </div>

        <div>
          <%= f.label :body, class: 'block text-sm font-medium text-gray-700 mb-2' do %>
            お問い合わせ内容 <span class="text-red-600">*</span>
          <% end %>
          <p class="text-xs text-gray-500 mb-2">詳細な内容をご入力ください（最大2000文字）</p>
          <%= f.text_area :body, rows: 10, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500', placeholder: '具体的な状況や質問内容をできるだけ詳しくお書きください。' %>
        </div>

        <div class="flex justify-end space-x-3">
          <%= link_to 'キャンセル', inquiries_path, class: 'bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded' %>
          <%= f.submit '送信', class: 'bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
