<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <div class="mb-6">
      <%= back_button "一覧に戻る", inquiries_path %>
    </div>

    <h1 class="text-3xl font-bold text-greige-900 mb-2">新規お問い合わせ</h1>
    <p class="text-sm text-greige-600 mb-6">
      お困りのことやご不明な点がございましたら、お気軽にお問い合わせください。
      管理者が確認次第、できるだけ早くご返信いたします。
    </p>

    <div class="bg-white shadow-md rounded p-6">
      <%= form_with model: @inquiry, local: true, class: 'space-y-6' do |f| %>
        <% if @inquiry.errors.any? %>
          <div class="bg-accent-danger/10 border border-accent-danger text-accent-danger px-4 py-3 rounded">
            <h3 class="font-bold mb-2">入力内容にエラーがあります</h3>
            <ul class="list-disc list-inside text-sm">
              <% @inquiry.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :category, class: 'block text-sm font-medium text-greige-700 mb-2' do %>
            カテゴリ <span class="text-accent-danger">*</span>
          <% end %>
          <p class="text-xs text-greige-500 mb-2">お問い合わせの種類を選択してください</p>
          <%= f.select :category,
            options_for_select(
              Inquiry.categories.keys.map { |key| [I18n.t("activerecord.attributes.inquiry.categories.#{key}"), key] },
              @inquiry.category
            ),
            { prompt: 'カテゴリを選択してください' },
            { class: 'mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary', data: { controller: 'tom-select' } } %>
        </div>

        <div>
          <%= f.label :subject, class: 'block text-sm font-medium text-greige-700 mb-2' do %>
            件名 <span class="text-accent-danger">*</span>
          <% end %>
          <p class="text-xs text-greige-500 mb-2">お問い合わせの内容を簡潔にご入力ください（最大100文字）</p>
          <%= f.text_field :subject, class: 'mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary', placeholder: '例: ログインできない、機能の使い方について', maxlength: 100 %>
        </div>

        <div>
          <%= f.label :body, class: 'block text-sm font-medium text-greige-700 mb-2' do %>
            お問い合わせ内容 <span class="text-accent-danger">*</span>
          <% end %>
          <p class="text-xs text-greige-500 mb-2">詳細な内容をご入力ください（最大2000文字）</p>
          <%= f.text_area :body, rows: 10, class: 'mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary', placeholder: '具体的な状況や質問内容をできるだけ詳しくお書きください。' %>
        </div>

        <div class="flex justify-end space-x-3">
          <%= cancel_button 'キャンセル', inquiries_path %>
          <%= f.submit '送信', class: 'bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
