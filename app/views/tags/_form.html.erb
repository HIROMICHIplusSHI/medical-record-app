<%= form_with(model: tag, local: true, class: "space-y-6") do |form| %>
  <% if tag.errors.any? %>
    <div class="bg-accent-danger/10 border border-accent-danger text-accent-danger px-4 py-3 rounded">
      <h2 class="font-bold mb-2"><%= pluralize(tag.errors.count, "件") %>のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% tag.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "タグ名", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary", placeholder: "例：施術部位、症状", required: true, maxlength: 50 %>
  </div>

  <div>
    <%= form.label :category, "カテゴリ", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.text_field :category, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary", placeholder: "例：施術、診断、症状" %>
    <p class="mt-1 text-sm text-greige-500">タグをグループ分けするためのカテゴリ（任意）</p>
  </div>

  <div>
    <%= form.label :color, "色", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <div class="flex items-center space-x-3">
      <%= form.color_field :color, value: tag.color || '#3B82F6', class: "h-10 w-20 rounded border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary" %>
      <span class="text-sm text-greige-600">タグの表示色を選択してください</span>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= cancel_button "キャンセル", tags_path %>
    <%= form.submit "保存", class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
  </div>
<% end %>
