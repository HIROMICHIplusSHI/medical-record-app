<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">タグ一覧</h1>
    <%= link_to "新しいタグを作成", new_tag_path, class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
  </div>

  <% if notice %>
    <div class="bg-accent-success/10 border border-accent-success text-accent-success px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <% if @tags.any? %>
    <div class="bg-white shadow-md rounded">
      <table class="min-w-full">
        <thead class="bg-greige-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">タグ名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">カテゴリ</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">色</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">使用回数</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-greige-200">
          <% @tags.each do |tag| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium" style="background-color: <%= tag.color %>20; color: <%= tag.color %>;">
                  <%= tag.name %>
                </span>
              </td>
              <td class="px-6 py-4"><%= tag.category %></td>
              <td class="px-6 py-4">
                <div class="flex items-center">
                  <div class="w-6 h-6 rounded border border-greige-300" style="background-color: <%= tag.color %>;"></div>
                  <span class="ml-2 text-sm text-greige-600"><%= tag.color %></span>
                </div>
              </td>
              <td class="px-6 py-4"><%= tag.medical_records.count %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= link_to "編集", edit_tag_path(tag), class: "text-accent-secondary hover:text-accent-secondary/80 transition-colors mr-3" %>
                <%= button_to "削除", tag, method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "text-accent-danger hover:text-accent-danger/80 transition-colors" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded p-8 text-center">
      <p class="text-greige-600 mb-4">まだタグが登録されていません。</p>
      <%= link_to "最初のタグを作成する", new_tag_path, class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
    </div>
  <% end %>
</div>
