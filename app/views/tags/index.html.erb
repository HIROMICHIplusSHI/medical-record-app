<div class="py-6 sm:py-8">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">タグ一覧</h1>
    <div><%= new_button "新しいタグを作成", new_tag_path %></div>
  </div>

  <% if notice %>
    <div class="bg-accent-success/10 border border-accent-success text-accent-success px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <% if @tags.any? %>
    <!-- スマホ・タブレット: カード表示（タブレットは2カラム） -->
    <div class="lg:hidden space-y-3 md:space-y-0 md:grid md:grid-cols-2 md:gap-3">
      <% @tags.each do |tag| %>
        <div class="bg-white shadow-sm border border-greige-200 rounded-lg p-4 flex flex-col">
          <div class="flex items-start justify-between gap-3">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium break-words" style="background-color: <%= tag.color %>20; color: <%= tag.color %>;">
              <%= tag.name %>
            </span>
            <span class="shrink-0 text-xs text-greige-500"><%= tag.medical_records.count %>件で使用</span>
          </div>
          <dl class="mt-3 space-y-1 text-sm text-greige-700">
            <div class="flex gap-2">
              <dt class="shrink-0 text-greige-500">カテゴリ</dt>
              <dd><%= tag.category.presence || '—' %></dd>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <dt class="shrink-0 text-greige-500">色</dt>
              <dd class="flex items-center gap-2">
                <span class="w-4 h-4 rounded border border-greige-300 inline-block" style="background-color: <%= tag.color %>;"></span>
                <span class="text-greige-600"><%= tag.color %></span>
              </dd>
            </div>
          </dl>
          <div class="mt-4 md:mt-auto md:pt-4 flex flex-wrap gap-2">
            <%= edit_button "編集", edit_tag_path(tag) %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- デスクトップ(lg以上): テーブル表示 -->
    <div class="hidden lg:block bg-white shadow-md rounded overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-greige-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">タグ名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">カテゴリ</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">色</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">使用回数</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-greige-200">
          <% @tags.each do |tag| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium" style="background-color: <%= tag.color %>20; color: <%= tag.color %>;">
                  <%= tag.name %>
                </span>
              </td>
              <td class="px-6 py-4"><%= tag.category %></td>
              <td class="px-6 py-4">
                <div class="flex items-center">
                  <div class="w-6 h-6 rounded border border-greige-300" style="background-color: <%= tag.color %>;"></div>
                  <span class="ml-2 text-sm text-greige-600"><%= tag.color %></span>
                </div>
              </td>
              <td class="px-6 py-4"><%= tag.medical_records.count %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= edit_button "編集", edit_tag_path(tag) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded p-8 text-center">
      <p class="text-greige-600 mb-4">まだタグが登録されていません。</p>
      <%= new_button "最初のタグを作成する", new_tag_path %>
    </div>
  <% end %>
</div>
