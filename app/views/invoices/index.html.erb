<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">請求書一覧</h1>
    <%= link_to "新しい請求書を作成", new_invoice_path, class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
  </div>

  <% if notice %>
    <div class="bg-accent-success/10 border border-accent-success text-accent-success px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <div class="mb-6 bg-white shadow-md rounded p-4">
    <%= search_form_for @q, url: invoices_path, method: :get, html: { class: "space-y-4" } do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :invoice_number_cont, "請求書番号", class: "block text-sm font-medium text-greige-700 mb-1" %>
          <%= f.text_field :invoice_number_cont, placeholder: "請求書番号で検索", class: "w-full rounded-lg border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary" %>
        </div>

        <div>
          <%= f.label :facility_id_eq, "施設", class: "block text-sm font-medium text-greige-700 mb-1" %>
          <%= f.collection_select :facility_id_eq, Facility.order(:name), :id, :name,
              { include_blank: "すべて" },
              { class: "w-full rounded-lg border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary", data: { controller: "tom-select" } } %>
        </div>

        <div>
          <%= f.label :status_eq, "ステータス", class: "block text-sm font-medium text-greige-700 mb-1" %>
          <%= f.select :status_eq,
              Invoice.statuses.keys.map { |k| [t("activerecord.attributes.invoice.statuses.#{k}"), k] },
              { include_blank: "すべて" },
              { class: "w-full rounded-lg border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary", data: { controller: "tom-select" } } %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :billing_period_start_gteq, "請求期間開始日（以降）", class: "block text-sm font-medium text-greige-700 mb-1" %>
          <%= f.date_field :billing_period_start_gteq, class: "w-full rounded-lg border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary" %>
        </div>

        <div>
          <%= f.label :billing_period_end_lteq, "請求期間終了日（以前）", class: "block text-sm font-medium text-greige-700 mb-1" %>
          <%= f.date_field :billing_period_end_lteq, class: "w-full rounded-lg border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary" %>
        </div>
      </div>

      <div class="flex gap-2">
        <%= f.submit "検索", class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-6 rounded-lg transition-colors" %>
        <%= link_to "クリア", invoices_path, class: "bg-greige-500 hover:bg-greige-700 text-white font-bold py-2 px-6 rounded-lg" %>
      </div>
    <% end %>
  </div>

  <% if @invoices.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @invoices.each do |invoice| %>
        <div class="bg-white shadow-md rounded-lg p-6 hover:shadow-lg transition-shadow">
          <!-- ヘッダー部分: 請求書番号とステータス -->
          <div class="flex justify-between items-start mb-4">
            <div>
              <%= link_to invoice.invoice_number, invoice, class: "text-lg font-bold text-accent-primary hover:text-accent-primary/80 transition-colors" %>
            </div>
            <span class="px-3 py-1 text-xs font-semibold rounded-full
              <%= case invoice.status
                  when 'draft' then 'bg-greige-100 text-greige-800'
                  when 'issued' then 'bg-blue-100 text-blue-800'
                  when 'sent' then 'bg-accent-warning/10 text-yellow-800'
                  when 'paid' then 'bg-accent-success/10 text-green-800'
                  when 'cancelled' then 'bg-accent-danger/10 text-red-800'
                  end %>">
              <%= t("activerecord.attributes.invoice.statuses.#{invoice.status}") %>
            </span>
          </div>

          <!-- 詳細情報 -->
          <div class="space-y-2 mb-4">
            <div class="flex justify-between text-sm">
              <span class="text-greige-600">施設:</span>
              <span class="font-medium"><%= invoice.facility.name %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-greige-600">請求期間:</span>
              <span class="font-medium"><%= invoice.period %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-greige-600">請求金額:</span>
              <span class="font-bold text-lg text-greige-900">¥<%= number_with_delimiter(invoice.billed_amount) %></span>
            </div>
            <% if invoice.facility.billing_rate.present? && invoice.facility.billing_rate != 100 %>
              <div class="flex justify-between text-xs">
                <span class="text-greige-500">（実費: ¥<%= number_with_delimiter(invoice.total_amount.to_i) %>）</span>
                <span class="text-greige-500">請求割合: <%= invoice.facility.billing_rate.to_i %>%</span>
              </div>
            <% end %>
          </div>

          <!-- 操作ボタン -->
          <div class="flex gap-2 pt-4 border-t border-greige-200">
            <%= link_to "表示", invoice, class: "flex-1 text-center bg-accent-primary hover:bg-accent-primary/90 text-white font-medium py-2 px-4 rounded transition-colors" %>
            <% if invoice.can_edit? %>
              <%= link_to "編集", edit_invoice_path(invoice), class: "flex-1 text-center bg-indigo-500 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded" %>
            <% end %>
            <% if invoice.can_delete? %>
              <%= button_to "削除", invoice, method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "flex-1 bg-accent-danger hover:bg-accent-danger/90 text-white font-medium py-2 px-4 rounded transition-colors" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6 flex justify-center">
      <%= paginate @invoices %>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded p-8 text-center">
      <p class="text-greige-600 mb-4">請求書が見つかりませんでした。</p>
      <%= link_to "新しい請求書を作成する", new_invoice_path, class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
    </div>
  <% end %>
</div>
