<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">請求書詳細</h1>
    <div class="flex items-center gap-2">
      <% if @invoice.can_edit? %>
        <%= link_to "編集", edit_invoice_path(@invoice), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
      <% if @invoice.can_refresh_items? %>
        <%= button_to "明細を更新", refresh_items_invoice_path(@invoice), method: :post, class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded", data: { turbo_confirm: "期間内のカルテから明細を再作成します。既存の明細は削除されますがよろしいですか？" } %>
      <% end %>
      <%= link_to "一覧に戻る", invoices_path, class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <% if notice %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <% if alert %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= alert %>
    </div>
  <% end %>

  <!-- 請求書基本情報 -->
  <div class="bg-white shadow-md rounded p-6 mb-6">
    <h2 class="text-xl font-bold text-gray-900 mb-4">基本情報</h2>
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <dt class="text-sm font-medium text-gray-500">請求書番号</dt>
        <dd class="mt-1 text-lg text-gray-900 font-semibold"><%= @invoice.invoice_number %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">ステータス</dt>
        <dd class="mt-1">
          <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full
            <%= case @invoice.status
                when 'draft' then 'bg-gray-100 text-gray-800'
                when 'issued' then 'bg-blue-100 text-blue-800'
                when 'sent' then 'bg-yellow-100 text-yellow-800'
                when 'paid' then 'bg-green-100 text-green-800'
                when 'cancelled' then 'bg-red-100 text-red-800'
                end %>">
            <%= t("activerecord.attributes.invoice.statuses.#{@invoice.status}") %>
          </span>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">施設</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= @invoice.facility.name %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">発行日</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= l @invoice.issued_at, format: :long %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">請求期間</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= @invoice.period %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">請求金額</dt>
        <dd class="mt-1 text-2xl font-bold text-gray-900">¥<%= number_with_delimiter(@invoice.billed_amount) %></dd>
        <% if @invoice.facility.billing_rate.present? && @invoice.facility.billing_rate != 100 %>
          <dd class="mt-1 text-sm text-gray-500">
            実費: ¥<%= number_with_delimiter(@invoice.total_amount.to_i) %> × <%= @invoice.facility.billing_rate.to_i %>%
          </dd>
        <% end %>
      </div>

      <% if @invoice.notes.present? %>
        <div class="md:col-span-2">
          <dt class="text-sm font-medium text-gray-500">備考</dt>
          <dd class="mt-1 text-lg text-gray-900 whitespace-pre-wrap"><%= @invoice.notes %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <!-- 請求書明細 -->
  <div class="bg-white shadow-md rounded p-6 mb-6">
    <h2 class="text-xl font-bold text-gray-900 mb-4">請求明細</h2>
    <% if @invoice_items.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">診療日</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">患者名</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">内容</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">金額</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @invoice_items.each do |item| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= item.medical_record.visit_date.strftime('%Y年%m月%d日') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= item.medical_record.patient.name %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 whitespace-pre-line">
                  <%= item.description %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right">
                  ¥<%= number_with_delimiter(item.amount.to_i) %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-gray-50">
            <tr>
              <td colspan="3" class="px-6 py-4 text-right text-sm font-bold text-gray-900">
                実費合計
                <% if @invoice.facility.billing_rate.present? && @invoice.facility.billing_rate != 100 %>
                  <br><span class="text-xs font-normal text-gray-600">請求割合 <%= @invoice.facility.billing_rate.to_i %>% 適用</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 text-right">
                ¥<%= number_with_delimiter(@invoice.total_amount.to_i) %>
                <% if @invoice.facility.billing_rate.present? && @invoice.facility.billing_rate != 100 %>
                  <br><span class="text-lg">¥<%= number_with_delimiter(@invoice.billed_amount) %></span>
                <% end %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <p class="text-gray-600 text-center py-4">請求明細がありません。</p>
    <% end %>
  </div>

  <!-- アクション -->
  <div class="bg-white shadow-md rounded p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-4">操作</h2>

    <!-- PDF生成フォーム -->
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">PDF生成オプション</h3>

      <div class="flex items-center mb-4">
        <input type="checkbox" id="tax-display-checkbox" <%= 'checked' if @invoice.tax_display %> class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
        <label for="tax-display-checkbox" class="ml-2 text-sm text-gray-700">消費税表示を含める</label>
        <span class="ml-2 text-xs text-gray-500">（チェックすると消費税込みの金額が表示されます）</span>
      </div>

      <div class="flex gap-2">
        <%= form_with url: generate_pdf_invoice_path(@invoice), method: :post, local: true, class: "inline" do |f| %>
          <%= hidden_field_tag :tax_display, "", id: "tax-display-hidden" %>
          <%= f.submit "PDF生成", class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded shadow", onclick: "document.getElementById('tax-display-hidden').value = document.getElementById('tax-display-checkbox').checked ? '1' : '0';" %>
        <% end %>

        <button type="button" onclick="previewPDF()" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded shadow" style="background-color: #9333ea; color: white; font-weight: bold; padding: 0.5rem 1rem; border-radius: 0.25rem; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1); cursor: pointer; border: none;">
          プレビュー
        </button>
      </div>

      <script>
        function previewPDF() {
          console.log('previewPDF function called');
          var checkbox = document.getElementById('tax-display-checkbox');
          console.log('checkbox:', checkbox);
          console.log('checkbox.checked:', checkbox ? checkbox.checked : 'checkbox not found');
          var taxDisplay = checkbox ? checkbox.checked : false;
          var url = '<%= preview_pdf_invoice_path(@invoice) %>?tax_display=' + taxDisplay;
          console.log('Opening URL:', url);
          window.open(url, '_blank');
        }
      </script>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to "PDFダウンロード", download_pdf_invoice_path(@invoice), class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded shadow inline-block" %>

      <% if @invoice.can_delete? %>
        <%= button_to "削除", @invoice, method: :delete,
            data: { turbo_confirm: "本当に削除しますか？この操作は取り消せません。" },
            class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded ml-auto" %>
      <% end %>
    </div>
  </div>

</div>
