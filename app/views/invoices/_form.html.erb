<%= form_with(model: invoice, local: true, class: "space-y-6", html: { 'aria-describedby': (invoice.errors.any? ? 'form-errors' : nil) }) do |form| %>
  <% if invoice.errors.any? %>
    <div id="form-errors" role="alert" class="bg-accent-danger/10 border border-accent-danger text-accent-danger px-4 py-3 rounded">
      <h2 class="font-bold mb-2"><%= pluralize(invoice.errors.count, "件") %>のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% invoice.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :facility_id, "施設", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.collection_select :facility_id, @facilities, :id, :name,
        { prompt: "施設を選択してください" },
        { class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary", disabled: invoice.persisted?, data: { controller: "tom-select" } } %>
    <% if invoice.persisted? %>
      <p class="mt-1 text-sm text-greige-500">※ 施設は変更できません</p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :billing_period_start, "請求期間開始日", class: "block text-sm font-medium text-greige-700 mb-2" %>
      <%= form.date_field :billing_period_start, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary" %>
    </div>

    <div>
      <%= form.label :billing_period_end, "請求期間終了日", class: "block text-sm font-medium text-greige-700 mb-2" %>
      <%= form.date_field :billing_period_end, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary" %>
    </div>
  </div>

  <% if invoice.persisted? %>
    <div>
      <%= form.label :status, "ステータス", class: "block text-sm font-medium text-greige-700 mb-2" %>
      <%= form.select :status,
          Invoice.statuses.keys.map { |k| [t("activerecord.attributes.invoice.statuses.#{k}"), k] },
          {},
          { class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary", data: { controller: "tom-select" } } %>
    </div>
  <% end %>

  <div>
    <%= form.label :notes, "備考", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.text_area :notes, rows: 4, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary", placeholder: "請求書に関する備考を入力してください" %>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "キャンセル", invoice.persisted? ? invoice : invoices_path, class: "bg-greige-300 hover:bg-greige-400 text-greige-800 font-bold py-2 px-4 rounded transition-colors" %>
    <%= form.submit invoice.persisted? ? "更新" : "作成", class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
  </div>
<% end %>
