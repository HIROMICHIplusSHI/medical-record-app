<%= form_with(model: invoice, local: true, class: "space-y-6") do |form| %>
  <% if invoice.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold mb-2"><%= pluralize(invoice.errors.count, "件") %>のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% invoice.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :facility_id, "施設", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.collection_select :facility_id, @facilities, :id, :name,
        { prompt: "施設を選択してください" },
        { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", disabled: invoice.persisted?, data: { controller: "tom-select" } } %>
    <% if invoice.persisted? %>
      <p class="mt-1 text-sm text-gray-500">※ 施設は変更できません</p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :billing_period_start, "請求期間開始日", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :billing_period_start, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= form.label :billing_period_end, "請求期間終了日", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :billing_period_end, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>
  </div>

  <% if invoice.persisted? %>
    <div>
      <%= form.label :status, "ステータス", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :status,
          Invoice.statuses.keys.map { |k| [t("activerecord.attributes.invoice.statuses.#{k}"), k] },
          {},
          { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", data: { controller: "tom-select" } } %>
    </div>
  <% end %>

  <div>
    <%= form.label :notes, "備考", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :notes, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "請求書に関する備考を入力してください" %>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "キャンセル", invoice.persisted? ? invoice : invoices_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded" %>
    <%= form.submit invoice.persisted? ? "更新" : "作成", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>
<% end %>
