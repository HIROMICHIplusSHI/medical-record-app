<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">請求書を編集</h1>
    <div>
      <%= link_to "詳細に戻る", @invoice, class: "bg-greige-500 hover:bg-greige-700 text-white font-bold py-2 px-4 rounded mr-2" %>
      <%= link_to "一覧に戻る", invoices_path, class: "bg-greige-500 hover:bg-greige-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <div class="bg-white shadow-md rounded p-6">
    <%= render "form", invoice: @invoice %>
  </div>
</div>
