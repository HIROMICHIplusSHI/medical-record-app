<div class="py-6 sm:py-8">
  <%= breadcrumb ['請求書', invoices_path], [@invoice.invoice_number, invoice_path(@invoice)], '編集' %>

  <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">請求書を編集</h1>
    <div class="flex flex-wrap gap-2 sm:gap-3">
      <%= show_button "詳細に戻る", @invoice %>
      <%= back_button "一覧に戻る", invoices_path %>
    </div>
  </div>

  <div class="bg-white shadow-md rounded p-6">
    <%= render "form", invoice: @invoice %>
  </div>

  <!-- 削除セクション -->
  <% if @invoice.can_delete? %>
    <div class="mt-8 bg-red-50 border border-red-200 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-red-900 mb-2">危険な操作</h3>
      <p class="text-sm text-red-700 mb-4">この請求書を削除します。この操作は取り消すことができません。</p>
      <%= button_to "請求書を削除", @invoice, method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded transition-colors" %>
    </div>
  <% end %>
</div>
