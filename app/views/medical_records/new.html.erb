<div class="w-full mx-auto px-4 py-8">
  <%= @patient ? patient_breadcrumb(@patient, ['施術履歴', patient_medical_records_path(@patient)], '新規作成') : breadcrumb(['施術履歴', medical_records_path], '新規作成') %>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:px-8">
      <h1 class="text-2xl font-semibold text-gray-900 mb-6">施術記録の新規作成</h1>
      <%= render 'form', medical_record: @medical_record %>
    </div>
  </div>
</div>
