<div class="w-full mx-auto px-4 py-8">
  <div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">カルテ一覧</h1>
      <p class="mt-2 text-sm text-gray-700">
        全<%= @medical_records.total_count %>件のカルテ
      </p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_medical_record_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
        <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        新規作成
      <% end %>
    </div>
  </div>

  <!-- 検索フォーム -->
  <div class="bg-white shadow sm:rounded-lg mb-6" data-controller="search-form">
    <div class="px-4 py-5 sm:p-6">
      <%= search_form_for @q, url: medical_records_path, html: { method: :get, class: 'space-y-4' } do |f| %>
        <!-- 基本検索（常に表示） -->
        <div class="flex items-center gap-4">
          <div class="flex-1">
            <%= f.label :patient_name_cont, '患者名で検索', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= f.search_field :patient_name_cont, class: 'block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '患者名を入力...' %>
          </div>
          <div class="flex items-end gap-2">
            <%= f.submit '検索', class: 'inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
            <%= link_to 'クリア', medical_records_path, class: 'inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
            <button type="button" data-action="click->search-form#toggle" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
              <span data-search-form-target="toggleText">詳細検索</span>
            </button>
          </div>
        </div>

        <!-- 詳細検索（アコーディオン） -->
        <div data-search-form-target="form" class="hidden">
          <div class="border-t pt-4 mt-4">
            <h4 class="text-sm font-medium text-gray-900 mb-3">詳細検索条件</h4>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <!-- 施設選択 -->
              <div>
                <%= f.label :facility_id_eq, '施設', class: 'block text-sm font-medium text-gray-700' %>
                <%= f.select :facility_id_eq,
                    options_from_collection_for_select(current_user.facilities.by_name, :id, :name, f.object.facility_id_eq),
                    { include_blank: 'すべて' },
                    { class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', data: { controller: 'tom-select' } } %>
              </div>

              <!-- タグ選択 -->
              <div>
                <%= f.label :tags_id_eq, 'タグ', class: 'block text-sm font-medium text-gray-700' %>
                <%= f.select :tags_id_eq,
                    options_from_collection_for_select(current_user.tags.by_name, :id, :name, f.object.tags_id_eq),
                    { include_blank: 'すべて' },
                    { class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', data: { controller: 'tom-select' } } %>
              </div>

              <!-- 来院日（開始） -->
              <div>
                <%= f.label :visit_date_gteq, '来院日（開始）', class: 'block text-sm font-medium text-gray-700' %>
                <%= f.date_field :visit_date_gteq, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
              </div>

              <!-- 来院日（終了） -->
              <div>
                <%= f.label :visit_date_lteq, '来院日（終了）', class: 'block text-sm font-medium text-gray-700' %>
                <%= f.date_field :visit_date_lteq, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
              </div>

              <!-- 主訴検索 -->
              <div>
                <%= f.label :chief_complaint_cont, '主訴', class: 'block text-sm font-medium text-gray-700' %>
                <%= f.search_field :chief_complaint_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: 'しわ' %>
              </div>

              <!-- ソート順 -->
              <div>
                <%= f.label :s, '並び替え', class: 'block text-sm font-medium text-gray-700' %>
                <%= f.select :s,
                    [
                      ['来院日（新しい順）', 'visit_date desc'],
                      ['来院日（古い順）', 'visit_date asc'],
                      ['患者名（昇順）', 'patient_name asc'],
                      ['患者名（降順）', 'patient_name desc']
                    ],
                    { selected: f.object.sorts.first&.to_s || 'visit_date desc' },
                    { class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', data: { controller: 'tom-select' } } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if @medical_records.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">来院日</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">患者名</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">施術場所</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">施術部位</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">主訴</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">タグ</th>
            <th scope="col" class="relative px-6 py-3">
              <span class="sr-only">操作</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @medical_records.each do |record| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= l(record.visit_date, format: :long) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= record.patient.name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= record.facility.name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= record.treatment_location %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900">
                <div class="max-w-xs truncate">
                  <%= record.chief_complaint %>
                </div>
              </td>
              <td class="px-6 py-4 text-sm text-gray-900">
                <div class="flex flex-wrap gap-1">
                  <% record.tags.each do |tag| %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium" style="background-color: <%= tag.color %>20; color: <%= tag.color %>;">
                      <%= tag.name %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to '詳細', record, class: "text-blue-600 hover:text-blue-900 mr-4" %>
                <%= link_to '編集', edit_medical_record_path(record), class: "text-green-600 hover:text-green-900 mr-4" %>
                <%= button_to '削除', record, method: :delete, form: { data: { turbo_confirm: 'カルテを削除してもよろしいですか？' } }, class: "text-red-600 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <!-- ページネーション -->
      <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
        <div class="flex-1 flex justify-between sm:hidden">
          <%= link_to_previous_page @medical_records, '前へ', class: 'relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50' %>
          <%= link_to_next_page @medical_records, '次へ', class: 'ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50' %>
        </div>
        <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
          <div>
            <p class="text-sm text-gray-700">
              全<span class="font-medium"><%= @medical_records.total_count %></span>件中
              <span class="font-medium"><%= @medical_records.offset_value + 1 %></span>〜
              <span class="font-medium"><%= [@medical_records.offset_value + @medical_records.length, @medical_records.total_count].min %></span>件を表示
            </p>
          </div>
          <div>
            <%= paginate @medical_records, window: 2, outer_window: 1 %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-lg shadow">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">カルテがありません</h3>
      <p class="mt-1 text-sm text-gray-500">最初のカルテを作成してください。</p>
      <div class="mt-6">
        <%= link_to new_medical_record_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          新規作成
        <% end %>
      </div>
    </div>
  <% end %>
</div>
