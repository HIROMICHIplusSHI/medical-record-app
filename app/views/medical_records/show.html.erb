<div class="w-full mx-auto px-4 py-8">
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6 flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900">カルテ詳細</h1>
        <p class="mt-1 text-sm text-gray-500">
          <%= l(@medical_record.visit_date, format: :long) %>
        </p>
      </div>
      <div class="flex space-x-3">
        <%= link_to '編集', edit_medical_record_path(@medical_record), class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        <%= button_to '削除', @medical_record, method: :delete, form: { data: { turbo_confirm: 'カルテを削除してもよろしいですか？' } }, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
      </div>
    </div>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-0">
      <dl class="sm:divide-y sm:divide-gray-200">
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">患者名</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @medical_record.patient.name %></dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">施術場所</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @medical_record.facility.name %></dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">来院日</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= l(@medical_record.visit_date, format: :long) %></dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">施術部位</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @medical_record.treatment_location %></dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">主訴</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 whitespace-pre-wrap"><%= @medical_record.chief_complaint %></dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">診断</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 whitespace-pre-wrap"><%= @medical_record.diagnosis %></dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">施術内容</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 whitespace-pre-wrap"><%= @medical_record.treatment_content %></dd>
        </div>
        <% if @medical_record.notes.present? %>
          <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">メモ</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 whitespace-pre-wrap"><%= @medical_record.notes %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <!-- 施術写真セクション -->
    <% if @medical_record.photos.attached? %>
      <div class="border-t border-gray-200">
        <div class="px-4 py-5 sm:px-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900">施術写真 (<%= @medical_record.photos.count %>枚)</h3>
        </div>
        <div class="px-4 pb-5 sm:px-6">
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <% @medical_record.photos.each do |photo| %>
              <div class="relative">
                <%= image_tag photo, class: "w-full h-48 object-cover rounded-lg shadow-sm cursor-pointer hover:opacity-90 transition-opacity", onclick: "openImageModal(this.src)" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- コスト項目セクション -->
    <% if @medical_record.cost_items.any? %>
      <div class="border-t border-gray-200">
        <div class="px-4 py-5 sm:px-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900">コスト項目</h3>
        </div>
        <div class="border-t border-gray-200">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">項目名</th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">数量</th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">単価</th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">合計</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @medical_record.cost_items.each do |cost_item| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= cost_item.item_name %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-right"><%= cost_item.quantity %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-right">¥<%= number_with_delimiter(cost_item.unit_price.to_i) %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right font-medium">¥<%= number_with_delimiter(cost_item.total_price.to_i) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="bg-gray-50">
              <tr>
                <td colspan="3" class="px-6 py-4 text-right text-sm font-semibold text-gray-900">合計金額</td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-base font-bold text-gray-900">¥<%= number_with_delimiter(@medical_record.total_cost.to_i) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    <% end %>

    <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
      <%= link_to '一覧に戻る', medical_records_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  </div>
</div>

<!-- 画像拡大モーダル -->
<div id="imageModal" class="fixed inset-0 bg-black bg-opacity-75 hidden z-50 flex items-center justify-center" onclick="closeImageModal()">
  <div class="relative max-w-screen-lg max-h-screen p-4">
    <img id="modalImage" src="" class="max-w-full max-h-full object-contain">
    <button onclick="closeImageModal()" class="absolute top-8 right-8 text-white text-4xl hover:text-gray-300">&times;</button>
  </div>
</div>

<script>
function openImageModal(src) {
  document.getElementById('imageModal').classList.remove('hidden');
  document.getElementById('modalImage').src = src;
}

function closeImageModal() {
  document.getElementById('imageModal').classList.add('hidden');
}
</script>
