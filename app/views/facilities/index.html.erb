<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">施設一覧</h1>
    <%= link_to "新しい施設を登録", new_facility_path, class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
  </div>

  <% if notice %>
    <div class="bg-accent-success/10 border border-accent-success text-accent-success px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <% if @facilities.any? %>
    <div class="bg-white shadow-md rounded">
      <table class="min-w-full">
        <thead class="bg-greige-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">施設名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">住所</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">電話番号</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">メールアドレス</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-greige-200">
          <% @facilities.each do |facility| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to facility.name, facility, class: "text-accent-primary hover:text-accent-primary/80 transition-colors" %>
              </td>
              <td class="px-6 py-4"><%= facility.address %></td>
              <td class="px-6 py-4"><%= facility.phone %></td>
              <td class="px-6 py-4"><%= facility.email %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= link_to "表示", facility, class: "text-accent-primary hover:text-accent-primary/80 mr-3" %>
                <%= link_to "編集", edit_facility_path(facility), class: "text-accent-secondary hover:text-accent-secondary/80 mr-3" %>
                <%= button_to "削除", facility, method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "text-accent-danger hover:text-accent-danger/80 transition-colors" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded p-8 text-center">
      <p class="text-greige-600 mb-4">まだ施設が登録されていません。</p>
      <%= link_to "最初の施設を登録する", new_facility_path, class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
    </div>
  <% end %>
</div>
