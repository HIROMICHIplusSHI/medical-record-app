<div class="py-6 sm:py-8">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">施設一覧</h1>
    <div><%= new_button "新しい施設を登録", new_facility_path %></div>
  </div>

  <% if notice %>
    <div class="bg-accent-success/10 border border-accent-success text-accent-success px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <% if @facilities.any? %>
    <!-- スマホ・タブレット: カード表示（タブレットは2カラム） -->
    <div class="lg:hidden space-y-3 md:space-y-0 md:grid md:grid-cols-2 md:gap-3">
      <% @facilities.each do |facility| %>
        <div class="bg-white shadow-sm border border-greige-200 rounded-lg p-4 flex flex-col">
          <%= link_to facility.name, facility, class: "text-base font-semibold text-accent-primary hover:text-accent-primary/80 transition-colors break-words" %>
          <dl class="mt-3 space-y-1 text-sm text-greige-700">
            <div class="flex gap-2">
              <dt class="shrink-0 text-greige-500">住所</dt>
              <dd class="break-words"><%= facility.address.presence || '—' %></dd>
            </div>
            <div class="flex gap-2">
              <dt class="shrink-0 text-greige-500">電話</dt>
              <dd class="break-all"><%= facility.phone.presence || '—' %></dd>
            </div>
            <div class="flex gap-2">
              <dt class="shrink-0 text-greige-500">メール</dt>
              <dd class="break-all"><%= facility.email.presence || '—' %></dd>
            </div>
          </dl>
          <div class="mt-4 md:mt-auto md:pt-4 flex flex-wrap gap-2">
            <%= show_button "表示", facility %>
            <%= edit_button "編集", edit_facility_path(facility) %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- デスクトップ(lg以上): テーブル表示 -->
    <div class="hidden lg:block bg-white shadow-md rounded overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-greige-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">施設名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">住所</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">電話番号</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">メールアドレス</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-greige-200">
          <% @facilities.each do |facility| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to facility.name, facility, class: "text-accent-primary hover:text-accent-primary/80 transition-colors" %>
              </td>
              <td class="px-6 py-4"><%= facility.address %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= facility.phone %></td>
              <td class="px-6 py-4"><%= facility.email %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                <%= show_button "表示", facility %>
                <%= edit_button "編集", edit_facility_path(facility) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded p-8 text-center">
      <p class="text-greige-600 mb-4">まだ施設が登録されていません。</p>
      <%= new_button "最初の施設を登録する", new_facility_path %>
    </div>
  <% end %>
</div>
