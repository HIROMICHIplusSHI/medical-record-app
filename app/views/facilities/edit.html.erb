<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">施設を編集</h1>
    <div class="flex space-x-3">
      <%= show_button "詳細に戻る", @facility %>
      <%= back_button "一覧に戻る", facilities_path %>
    </div>
  </div>

  <div class="bg-white shadow-md rounded p-6">
    <%= render "form", facility: @facility %>
  </div>

  <!-- 削除セクション -->
  <div class="mt-8 bg-red-50 border border-red-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-red-900 mb-2">危険な操作</h3>
    <p class="text-sm text-red-700 mb-4">この施設を削除すると、関連するカルテや請求書も全て削除されます。この操作は取り消すことができません。</p>
    <%= button_to "施設を削除", @facility, method: :delete, data: { turbo_confirm: "本当に削除しますか？関連するカルテや請求書も全て削除されます。" }, class: "bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded transition-colors" %>
  </div>
</div>
