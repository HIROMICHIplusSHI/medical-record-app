<%= form_with(model: facility, local: true, class: "space-y-6", html: { 'aria-describedby': (facility.errors.any? ? 'form-errors' : nil) }) do |form| %>
  <% if facility.errors.any? %>
    <div id="form-errors" role="alert" class="bg-accent-danger/10 border border-accent-danger text-accent-danger px-4 py-3 rounded">
      <h2 class="font-bold mb-2"><%= pluralize(facility.errors.count, "件") %>のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% facility.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "施設名", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary", placeholder: "例：渋谷クリニック" %>
  </div>

  <div>
    <%= form.label :address, "住所", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.text_area :address, rows: 3, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary", placeholder: "例：東京都渋谷区1-1-1" %>
  </div>

  <div>
    <%= form.label :phone, "電話番号", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.text_field :phone, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary", placeholder: "例：03-1234-5678" %>
  </div>

  <div>
    <%= form.label :email, "メールアドレス", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.email_field :email, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary", placeholder: "例：info@example.com" %>
  </div>

  <div>
    <%= form.label :notes, "備考", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.text_area :notes, rows: 4, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary", placeholder: "施設に関する備考を入力してください" %>
  </div>

  <!-- 医師情報セクション -->
  <div class="border-t pt-6 mt-6" data-controller="nested-form">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-medium text-greige-900">医師情報</h3>
      <button type="button" data-action="click->nested-form#addItem" class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-accent-primary hover:bg-accent-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary transition-colors">
        <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        医師を追加
      </button>
    </div>

    <div data-nested-form-target="container">
      <%= form.fields_for :facility_doctors do |facility_doctor_form| %>
        <%= render 'facility_doctor_fields', f: facility_doctor_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= form.fields_for :facility_doctors, FacilityDoctor.new, child_index: 'NEW_RECORD' do |facility_doctor_form| %>
        <%= render 'facility_doctor_fields', f: facility_doctor_form %>
      <% end %>
    </template>
  </div>

  <!-- 請求書関連情報 -->
  <div class="border-t pt-6 mt-6">
    <h3 class="text-lg font-medium text-greige-900 mb-4">請求書設定</h3>

    <div class="space-y-4">
      <div>
        <%= form.label :billing_addressee, "請求先宛名", class: "block text-sm font-medium text-greige-700 mb-2" %>
        <p class="text-xs text-greige-500 mb-2">空欄の場合は「施設名 御中」で表示されます</p>
        <%= form.text_field :billing_addressee, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary", placeholder: "例：株式会社○○ 御中" %>
      </div>

      <div>
        <%= form.label :billing_rate, "請求割合（%）", class: "block text-sm font-medium text-greige-700 mb-2" %>
        <p class="text-xs text-greige-500 mb-2">実費に対する請求割合（0〜100）。空欄の場合は100%で計算されます</p>
        <%= form.number_field :billing_rate, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary", placeholder: "100", min: 0, max: 100, step: 0.01 %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= cancel_button "キャンセル", facility.persisted? ? facility : facilities_path %>
    <%= form.submit "保存", class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
  </div>
<% end %>
