<%= form_with(model: facility, local: true, class: "space-y-6") do |form| %>
  <% if facility.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold mb-2"><%= pluralize(facility.errors.count, "件") %>のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% facility.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "施設名", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：渋谷クリニック" %>
  </div>

  <div>
    <%= form.label :address, "住所", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :address, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：東京都渋谷区1-1-1" %>
  </div>

  <div>
    <%= form.label :phone, "電話番号", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :phone, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：03-1234-5678" %>
  </div>

  <div>
    <%= form.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.email_field :email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：info@example.com" %>
  </div>

  <div>
    <%= form.label :notes, "備考", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :notes, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "施設に関する備考を入力してください" %>
  </div>

  <!-- 請求書関連情報 -->
  <div class="border-t pt-6 mt-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">請求書設定</h3>

    <div class="space-y-4">
      <div>
        <%= form.label :billing_addressee, "請求先宛名", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <p class="text-xs text-gray-500 mb-2">空欄の場合は「施設名 御中」で表示されます</p>
        <%= form.text_field :billing_addressee, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：株式会社○○ 御中" %>
      </div>

      <div>
        <%= form.label :billing_rate, "請求割合（%）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <p class="text-xs text-gray-500 mb-2">実費に対する請求割合（0〜100）。空欄の場合は100%で計算されます</p>
        <%= form.number_field :billing_rate, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "100", min: 0, max: 100, step: 0.01 %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "キャンセル", facilities_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded" %>
    <%= form.submit "保存", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>
<% end %>
