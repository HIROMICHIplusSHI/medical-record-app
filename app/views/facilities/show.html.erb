<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">施設詳細</h1>
    <div>
      <%= link_to "編集", edit_facility_path(@facility), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mr-2" %>
      <%= link_to "一覧に戻る", facilities_path, class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <% if notice %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded p-6">
    <dl class="grid grid-cols-1 gap-6">
      <div>
        <dt class="text-sm font-medium text-gray-500">施設名</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= @facility.name %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">住所</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= @facility.address || "未登録" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">電話番号</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= @facility.phone || "未登録" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">メールアドレス</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= @facility.email || "未登録" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">備考</dt>
        <dd class="mt-1 text-lg text-gray-900 whitespace-pre-wrap"><%= @facility.notes || "なし" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">作成日時</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= l @facility.created_at, format: :long %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">更新日時</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= l @facility.updated_at, format: :long %></dd>
      </div>
    </dl>

    <div class="mt-6 pt-6 border-t border-gray-200">
      <%= button_to "この施設を削除", @facility, method: :delete, data: { turbo_confirm: "本当に削除しますか？この操作は取り消せません。" }, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>
</div>
