<%# 全一覧共通のページネーション。タップ領域を最低44pxに保つ %>
<%= paginator.render do %>
  <nav class="pagination flex flex-wrap items-center justify-center gap-1" role="navigation" aria-label="ページネーション">
    <%= prev_page_tag %>
    <% each_page do |page| %>
      <% if page.left_outer? || page.right_outer? || page.inside_window? %>
        <%= page_tag page %>
      <% elsif !page.was_truncated? %>
        <%= gap_tag %>
      <% end %>
    <% end %>
    <%= next_page_tag %>
  </nav>
<% end %>
