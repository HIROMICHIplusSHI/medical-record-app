<div class="py-6 sm:py-8">
  <%= breadcrumb ['同意書テンプレート', consent_form_templates_path], @consent_form_template.title %>

  <div class="mb-6">
    <%= back_button '← 一覧に戻る', consent_form_templates_path %>
  </div>

  <div class="bg-white rounded-lg shadow p-8">
    <h1 class="text-3xl font-bold text-greige-900 mb-4"><%= @consent_form_template.title %></h1>

    <div class="mb-6">
      <span class="inline-block px-3 py-1 rounded-full text-sm <%= @consent_form_template.is_active ? 'bg-accent-success/10 text-accent-success/90' : 'bg-greige-100 text-greige-800' %>">
        <%= @consent_form_template.is_active ? '使用中' : '停止中' %>
      </span>
    </div>

    <% if @consent_form_template.description.present? %>
      <div class="mb-6">
        <h2 class="text-lg font-semibold text-greige-900 mb-2">説明</h2>
        <p class="text-greige-700"><%= simple_format(@consent_form_template.description) %></p>
      </div>
    <% end %>

    <div class="mb-6">
      <h2 class="text-lg font-semibold text-greige-900 mb-4">チェック項目（<%= @consent_form_template.consent_form_items.count %>件）</h2>
      <% if @consent_form_template.consent_form_items.any? %>
        <ul class="space-y-2">
          <% @consent_form_template.consent_form_items.each do |item| %>
            <li class="flex items-start">
              <span class="mr-2"><%= item.is_required ? '☑' : '☐' %></span>
              <span class="text-greige-700">
                <%= item.content %>
                <% if item.is_required %>
                  <span class="text-accent-danger text-sm">（必須）</span>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-greige-500">チェック項目が登録されていません。</p>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-2 sm:gap-3">
      <%= edit_button '編集', edit_consent_form_template_path(@consent_form_template) %>
      <%= delete_button '削除', @consent_form_template, data: { turbo_confirm: '本当に削除しますか？' } %>
    </div>
  </div>
</div>
