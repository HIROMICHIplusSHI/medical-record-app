<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">同意書テンプレート一覧</h1>
    <%= link_to '新規作成', new_consent_form_template_path, class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
  </div>

  <% if @consent_form_templates.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @consent_form_templates.each do |template| %>
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-greige-900 mb-2"><%= template.title %></h2>
          <p class="text-greige-600 text-sm mb-4"><%= truncate(template.description, length: 100) %></p>
          <div class="flex items-center justify-between text-sm text-greige-500 mb-4">
            <span class="<%= template.is_active ? 'text-green-600' : 'text-gray-400' %>">
              <%= template.is_active ? '使用中' : '停止中' %>
            </span>
            <span>項目: <%= template.consent_form_items.count %>件</span>
          </div>
          <div class="flex space-x-2">
            <%= link_to '詳細', template, class: "text-accent-primary hover:text-accent-primary/90 transition-colors" %>
            <%= link_to '編集', edit_consent_form_template_path(template), class: "text-green-600 hover:text-accent-success/90" %>
            <%= link_to '削除', template, method: :delete, data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' }, class: "text-accent-danger hover:text-red-800" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-greige-500">まだテンプレートが登録されていません。</p>
  <% end %>
</div>
