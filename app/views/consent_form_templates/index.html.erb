<div class="py-6 sm:py-8">
  <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">同意書テンプレート一覧</h1>
    <%= new_button '新規作成', new_consent_form_template_path %>
  </div>

  <% if @consent_form_templates.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @consent_form_templates.each do |template| %>
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-greige-900 mb-2"><%= template.title %></h2>
          <p class="text-greige-600 text-sm mb-4"><%= truncate(template.description, length: 100) %></p>
          <div class="flex items-center justify-between text-sm text-greige-500 mb-4">
            <span class="<%= template.is_active ? 'text-green-600' : 'text-gray-400' %>">
              <%= template.is_active ? '使用中' : '停止中' %>
            </span>
            <span>項目: <%= template.consent_form_items.count %>件</span>
          </div>
          <div class="flex space-x-2">
            <%= show_button '表示', template %>
            <%= edit_button '編集', edit_consent_form_template_path(template) %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-greige-500">まだテンプレートが登録されていません。</p>
  <% end %>
</div>
