<div class="py-6 sm:py-8">
  <%= breadcrumb ['同意書テンプレート', consent_form_templates_path], [@consent_form_template.title, consent_form_template_path(@consent_form_template)], '編集' %>

  <h1 class="text-3xl font-bold text-greige-900 mb-6">同意書テンプレート編集</h1>
  <%= render 'form', consent_form_template: @consent_form_template %>

  <!-- 削除セクション -->
  <div class="mt-8 bg-red-50 border border-red-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-red-900 mb-2">危険な操作</h3>
    <p class="text-sm text-red-700 mb-4">このテンプレートを削除します。この操作は取り消すことができません。</p>
    <%= button_to "テンプレートを削除", @consent_form_template, method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded transition-colors" %>
  </div>
</div>
