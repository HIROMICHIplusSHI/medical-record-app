<div class="consent-form-item-row bg-gray-50 p-4 rounded-lg" data-nested-form-target="item">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-12">
    <div class="sm:col-span-6">
      <%= f.label :content, "項目内容", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :content, rows: 2, class: "mt-1 focus:ring-blue-500 focus:border-blue-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", placeholder: "例：施術にはリスクがあることを理解しました" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :position, "表示順", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :position, class: "mt-1 focus:ring-blue-500 focus:border-blue-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md", placeholder: "1" %>
    </div>

    <div class="sm:col-span-3 flex items-end">
      <%= f.label :is_required, class: "inline-flex items-center cursor-pointer" do %>
        <%= f.check_box :is_required, class: "rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50" %>
        <span class="ml-2 text-sm text-gray-700">必須項目</span>
      <% end %>
    </div>

    <div class="sm:col-span-1 flex items-end">
      <button type="button" data-action="click->nested-form#removeItem" class="w-full inline-flex justify-center items-center px-3 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </button>
    </div>
  </div>

  <%= f.hidden_field :_destroy, data: { nested_form_target: "destroyField" } %>
</div>
