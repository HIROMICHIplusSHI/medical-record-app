<%= form_with(model: consent_form_template, local: true, class: "space-y-6", data: { controller: "nested-form" }) do |form| %>
  <% if consent_form_template.errors.any? %>
    <div class="bg-accent-danger/10 border border-accent-danger text-accent-danger px-4 py-3 rounded">
      <h2 class="font-bold mb-2"><%= pluralize(consent_form_template.errors.count, "件") %>のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% consent_form_template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "タイトル", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.text_field :title, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary", placeholder: "例：アートメイク施術同意書" %>
  </div>

  <div>
    <%= form.label :description, "説明文", class: "block text-sm font-medium text-greige-700 mb-2" %>
    <%= form.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary", placeholder: "施術前に必ずご確認ください。" %>
  </div>

  <div>
    <%= form.label :is_active, class: "inline-flex items-center" do %>
      <%= form.check_box :is_active, class: "rounded border-greige-300 text-accent-primary shadow-sm focus:border-accent-primary/50 focus:ring focus:ring-blue-200 focus:ring-opacity-50" %>
      <span class="ml-2 text-sm text-greige-700">使用中</span>
    <% end %>
  </div>

  <!-- チェック項目セクション -->
  <div class="border-t pt-6 mt-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-medium text-greige-900">チェック項目</h3>
      <button type="button" data-action="click->nested-form#addItem" class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-accent-primary hover:bg-accent-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary">
        <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        項目を追加
      </button>
    </div>

    <div
      data-nested-form-target="container"
      data-controller="sortable"
      <% if consent_form_template.persisted? %>
        data-sortable-url-value="<%= sort_items_consent_form_template_path(consent_form_template) %>"
      <% end %>
      class="space-y-3"
    >
      <%= form.fields_for :consent_form_items do |item_form| %>
        <%= render 'consent_form_item_fields', f: item_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= form.fields_for :consent_form_items, ConsentFormItem.new, child_index: 'NEW_RECORD' do |item_form| %>
        <%= render 'consent_form_item_fields', f: item_form %>
      <% end %>
    </template>
  </div>

  <div class="flex justify-end space-x-3">
    <%= cancel_button 'キャンセル', consent_form_template.persisted? ? consent_form_template : consent_form_templates_path %>
    <%= form.submit "保存", class: "bg-accent-primary hover:bg-accent-primary/90 text-white font-bold py-2 px-4 rounded transition-colors" %>
  </div>
<% end %>
