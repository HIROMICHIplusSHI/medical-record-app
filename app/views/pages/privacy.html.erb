<div class="max-w-4xl mx-auto py-8 px-4">
  <div class="bg-white rounded-lg shadow-sm border border-greige-200 p-8">
    <h1 class="text-3xl font-bold text-greige-900 mb-6 border-b border-greige-200 pb-4">
      プライバシーポリシー
    </h1>

    <div class="text-sm text-greige-600 mb-8">
      <strong>最終更新日：<%= l(TermsConstants::PRIVACY_UPDATED_AT, format: :long) %></strong>
    </div>

    <div class="prose prose-greige max-w-none space-y-6 text-greige-800">
      <%# Markdownファイルの内容を表示 %>
      <%=
        render_markdown('docs/privacy_policy.md')
          .gsub('[サービス名]', TermsConstants::SERVICE_NAME)
          .gsub('2025年○月○日', l(TermsConstants::PRIVACY_UPDATED_AT, format: :long))
          .gsub('privacy@[ドメイン名]', TermsConstants::PRIVACY_EMAIL)
          .gsub('[氏名又は屋号]', TermsConstants::OPERATOR_NAME)
          .gsub('[住所]', TermsConstants::OPERATOR_ADDRESS)
          .gsub('[メールアドレス]', TermsConstants::CONTACT_EMAIL)
          .gsub('[氏名又は役職名]', TermsConstants::PRIVACY_MANAGER)
          .html_safe
      %>
    </div>

    <hr class="border-greige-200 my-8">

    <!-- お問い合わせ -->
    <section class="bg-greige-50 p-6 rounded-lg border border-greige-200 space-y-3">
      <h2 class="text-lg font-bold text-greige-900">お問い合わせ</h2>
      <p class="text-sm">
        本ポリシーに関するご質問、個人情報の開示・削除依頼等は、以下の連絡先までお願いいたします。
      </p>
      <ul class="text-sm space-y-1">
        <li><strong>サービス名：</strong><%= TermsConstants::SERVICE_NAME %></li>
        <li><strong>個人情報に関するお問い合わせ：</strong><%= TermsConstants::PRIVACY_EMAIL %></li>
        <li><strong>一般お問い合わせ：</strong><%= TermsConstants::CONTACT_EMAIL %></li>
        <li><strong>受付時間：</strong><%= TermsConstants::SUPPORT_HOURS %></li>
      </ul>
    </section>

    <div class="text-center mt-8 pt-6 border-t border-greige-200">
      <p class="text-sm text-greige-600">
        本ポリシーに同意いただいた上で、サービスをご利用ください。
      </p>
    </div>
  </div>
</div>
