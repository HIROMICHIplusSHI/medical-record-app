<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">コストシート編集</h1>
    <p class="mt-2 text-sm text-greige-600">施術や薬剤の標準価格を編集します。</p>
  </div>

  <div class="bg-white shadow-md rounded-lg p-6">
    <%= render "form", cost_sheet: @cost_sheet %>
  </div>

  <!-- 削除セクション -->
  <div class="mt-8 bg-red-50 border border-red-200 rounded-lg p-6">
    <h3 class="text-lg font-semibold text-red-900 mb-2">危険な操作</h3>
    <p class="text-sm text-red-700 mb-4">このコストシートを削除します。この操作は取り消すことができません。</p>
    <%= button_to "コストシートを削除", @cost_sheet, method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded transition-colors" %>
  </div>
</div>
