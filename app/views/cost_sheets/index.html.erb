<div class="max-w-7xl mx-auto py-6 sm:py-8">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">コストシート管理</h1>
    <div><%= new_button "新規作成", new_cost_sheet_path %></div>
  </div>

  <% if @cost_sheets.any? %>
    <!-- スマホ・タブレット: カード表示（タブレットは2カラム） -->
    <div class="lg:hidden space-y-3 md:space-y-0 md:grid md:grid-cols-2 md:gap-3">
      <% @cost_sheets.each do |cost_sheet| %>
        <div class="bg-white shadow-sm border border-greige-200 rounded-lg p-4 flex flex-col">
          <div class="flex items-start justify-between gap-3">
            <div class="text-base font-semibold text-greige-900 break-words"><%= cost_sheet.item_name %></div>
            <span class="shrink-0 px-2 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
              <%= cost_sheet.category_name %>
            </span>
          </div>
          <p class="mt-2 text-lg font-bold text-greige-900">¥<%= number_with_delimiter(cost_sheet.standard_price) %></p>
          <% if cost_sheet.memo.present? %>
            <p class="mt-2 text-sm text-greige-500 break-words"><%= truncate(cost_sheet.memo, length: 80) %></p>
          <% end %>
          <div class="mt-4 md:mt-auto md:pt-4">
            <%= edit_button "編集", edit_cost_sheet_path(cost_sheet) %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- デスクトップ(lg以上): テーブル表示 -->
    <div class="hidden lg:block bg-white shadow-md rounded-lg overflow-x-auto">
      <table class="min-w-full divide-y divide-greige-200">
        <thead class="bg-greige-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">
              項目名
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">
              カテゴリ
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">
              標準価格
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">
              メモ
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-greige-500 uppercase tracking-wider">
              操作
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-greige-200">
          <% @cost_sheets.each do |cost_sheet| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-greige-900"><%= cost_sheet.item_name %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                  <%= cost_sheet.category_name %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-greige-900">
                ¥<%= number_with_delimiter(cost_sheet.standard_price) %>
              </td>
              <td class="px-6 py-4 text-sm text-greige-500">
                <%= truncate(cost_sheet.memo, length: 50) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= edit_button "編集", edit_cost_sheet_path(cost_sheet) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded-lg p-8 text-center">
      <p class="text-greige-500 mb-4">コストシートがまだ登録されていません。</p>
      <%= new_button "最初のコストシートを作成", new_cost_sheet_path %>
    </div>
  <% end %>
</div>
