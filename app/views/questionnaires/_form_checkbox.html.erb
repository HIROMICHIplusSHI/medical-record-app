<%# 新UI: チェックボックス版（Phase 3で有効化予定） %>
<%# セクション2: 医療情報 %>
<div class="bg-white border-2 border-gray-200 rounded-lg p-6">
  <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-green-500">医療情報</h2>

  <div class="space-y-8">
    <%# 2-1. 既往歴・治療中の病気 %>
    <div class="border-l-4 border-green-400 pl-4">
      <label class="block text-lg font-bold text-gray-900 mb-4">既往歴または現在治療中の病気はありますか？</label>

      <div class="flex space-x-6 mb-4">
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_medical_conditions", "true", @medical_conditions_array.any?,
              class: "form-radio h-6 w-6 text-green-600",
              data: { action: "questionnaire#toggleMedicalConditions" } %>
          <span class="ml-3 text-lg font-medium">あり</span>
        </label>
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_medical_conditions", "false", @medical_conditions_array.empty?,
              class: "form-radio h-6 w-6 text-green-600",
              data: { action: "questionnaire#toggleMedicalConditions" } %>
          <span class="ml-3 text-lg font-medium">なし</span>
        </label>
      </div>

      <div class="<%= @medical_conditions_array.any? ? '' : 'hidden' %> mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="medicalConditionsDetail">
        <p class="text-sm font-medium text-gray-700 mb-3">該当するものをすべて選択してください：</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "hypertension", @medical_conditions_array.include?("hypertension"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">高血圧</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "diabetes", @medical_conditions_array.include?("diabetes"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">糖尿病</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "dyslipidemia", @medical_conditions_array.include?("dyslipidemia"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">脂質異常症（高脂血症）</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "liver_disease", @medical_conditions_array.include?("liver_disease"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">肝機能障害</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "kidney_disease", @medical_conditions_array.include?("kidney_disease"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">腎機能障害</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "heart_disease", @medical_conditions_array.include?("heart_disease"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">心疾患（不整脈、心筋梗塞など）</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "cerebrovascular_disease", @medical_conditions_array.include?("cerebrovascular_disease"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">脳血管疾患（脳梗塞、脳出血など）</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "thyroid_disease", @medical_conditions_array.include?("thyroid_disease"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">甲状腺疾患</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "respiratory_disease", @medical_conditions_array.include?("respiratory_disease"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">喘息・呼吸器疾患</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "epilepsy", @medical_conditions_array.include?("epilepsy"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">てんかん</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "blood_disease", @medical_conditions_array.include?("blood_disease"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">血液の病気（貧血、白血病など）</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "cancer", @medical_conditions_array.include?("cancer"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">がん（現在治療中または過去の既往）</span>
          </label>
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medical_conditions[]", "autoimmune_disease", @medical_conditions_array.include?("autoimmune_disease"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">自己免疫疾患（関節リウマチ、膠原病など）</span>
          </label>
        </div>

        <div class="mt-4">
          <label class="flex items-start p-3 bg-white rounded border border-gray-200 cursor-pointer">
            <%= check_box_tag "has_other_condition", "true", false,
                class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                data: { action: "questionnaire#toggleOtherConditionDetail" } %>
            <span class="ml-3 text-base">その他</span>
          </label>
          <div id="other_condition_detail" class="hidden mt-2 ml-8">
            <%= text_field_tag "other_medical_condition", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                placeholder: "その他の病気を記入してください" %>
          </div>
        </div>
      </div>

      <%# Hidden field for storing JSON data %>
      <%= form.hidden_field :medical_conditions, id: "medical_conditions_json" %>
    </div>

    <%# 2-2. アレルギー %>
    <div class="border-l-4 border-green-400 pl-4">
      <label class="block text-lg font-bold text-gray-900 mb-4">アレルギーはありますか？</label>

      <div class="flex space-x-6 mb-4">
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_allergies", "true", @allergies_array.any?,
              class: "form-radio h-6 w-6 text-green-600",
              data: { action: "questionnaire#toggleAllergies" } %>
          <span class="ml-3 text-lg font-medium">あり</span>
        </label>
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_allergies", "false", @allergies_array.empty?,
              class: "form-radio h-6 w-6 text-green-600",
              data: { action: "questionnaire#toggleAllergies" } %>
          <span class="ml-3 text-lg font-medium">なし</span>
        </label>
      </div>

      <div class="<%= @allergies_array.any? ? '' : 'hidden' %> mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="allergiesDetail">
        <p class="text-sm font-medium text-gray-700 mb-3">該当するものをすべて選択してください：</p>
        <div class="space-y-3">
          <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "allergies[]", "drug_allergy", @allergies_array.include?("drug_allergy"),
                class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                data: { action: "questionnaire#toggleDrugAllergyDetail" } %>
            <span class="ml-3 text-base">薬物アレルギー</span>
          </label>
          <div id="drug_allergy_detail" class="hidden ml-8">
            <%= text_field_tag "drug_allergy_detail", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                placeholder: "薬品名を記入してください（例：ペニシリン系）" %>
          </div>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "allergies[]", "metal_allergy", @allergies_array.include?("metal_allergy"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">金属アレルギー</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "allergies[]", "latex_allergy", @allergies_array.include?("latex_allergy"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">ラテックスアレルギー</span>
          </label>

          <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "allergies[]", "food_allergy", @allergies_array.include?("food_allergy"),
                class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                data: { action: "questionnaire#toggleFoodAllergyDetail" } %>
            <span class="ml-3 text-base">食物アレルギー</span>
          </label>
          <div id="food_allergy_detail" class="hidden ml-8">
            <%= text_field_tag "food_allergy_detail", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                placeholder: "食品名を記入してください（例：そば、卵など）" %>
          </div>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "allergies[]", "hay_fever", @allergies_array.include?("hay_fever"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">花粉症</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "allergies[]", "atopic_dermatitis", @allergies_array.include?("atopic_dermatitis"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">アトピー性皮膚炎</span>
          </label>

          <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "has_other_allergy", "true", false,
                class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                data: { action: "questionnaire#toggleOtherAllergyDetail" } %>
            <span class="ml-3 text-base">その他</span>
          </label>
          <div id="other_allergy_detail" class="hidden ml-8">
            <%= text_field_tag "other_allergy", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                placeholder: "その他のアレルギーを記入してください" %>
          </div>
        </div>
      </div>

      <%# Hidden field for storing JSON data %>
      <%= form.hidden_field :allergies, id: "allergies_json" %>
    </div>

    <%# 2-3. 現在の服薬状況 %>
    <div class="border-l-4 border-green-400 pl-4">
      <label class="block text-lg font-bold text-gray-900 mb-4">現在、定期的に服用している薬はありますか？</label>

      <div class="flex space-x-6 mb-4">
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_medications", "true", @current_medications_array.any?,
              class: "form-radio h-6 w-6 text-green-600",
              data: { action: "questionnaire#toggleMedications" } %>
          <span class="ml-3 text-lg font-medium">あり</span>
        </label>
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_medications", "false", @current_medications_array.empty?,
              class: "form-radio h-6 w-6 text-green-600",
              data: { action: "questionnaire#toggleMedications" } %>
          <span class="ml-3 text-lg font-medium">なし</span>
        </label>
      </div>

      <div class="<%= @current_medications_array.any? ? '' : 'hidden' %> mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="medicationsDetail">
        <p class="text-sm font-medium text-gray-700 mb-3">該当するものをすべて選択してください：</p>
        <div class="space-y-3">
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medications[]", "blood_pressure", @current_medications_array.include?("blood_pressure"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">血圧の薬</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medications[]", "diabetes_medication", @current_medications_array.include?("diabetes_medication"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">糖尿病の薬（インスリン含む）</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medications[]", "anticoagulant", @current_medications_array.include?("anticoagulant"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">血液をサラサラにする薬（抗凝固薬・抗血小板薬）</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medications[]", "steroid", @current_medications_array.include?("steroid"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">ステロイド</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medications[]", "immunosuppressant", @current_medications_array.include?("immunosuppressant"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">免疫抑制剤</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medications[]", "hormone", @current_medications_array.include?("hormone"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">ホルモン剤</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medications[]", "psychiatric_medication", @current_medications_array.include?("psychiatric_medication"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">精神科・心療内科の薬</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medications[]", "painkiller", @current_medications_array.include?("painkiller"), class: "form-checkbox h-5 w-5 text-green-600" %>
            <span class="ml-3 text-base">痛み止め・鎮痛剤（常用）</span>
          </label>

          <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "medications[]", "supplement", @current_medications_array.include?("supplement"),
                class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                data: { action: "questionnaire#toggleSupplementDetail" } %>
            <span class="ml-3 text-base">サプリメント</span>
          </label>
          <div id="supplement_detail" class="hidden ml-8">
            <%= text_field_tag "supplement_detail", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                placeholder: "サプリメント名を記入してください" %>
          </div>

          <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "has_other_medication", "true", false,
                class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                data: { action: "questionnaire#toggleOtherMedicationDetail" } %>
            <span class="ml-3 text-base">その他</span>
          </label>
          <div id="other_medication_detail" class="hidden ml-8">
            <%= text_field_tag "other_medication", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                placeholder: "その他の薬を記入してください" %>
          </div>
        </div>
      </div>

      <%# Hidden field for storing JSON data %>
      <%= form.hidden_field :current_medications, id: "current_medications_json" %>
    </div>

    <%# 2-4. 手術歴 %>
    <div class="border-l-4 border-green-400 pl-4">
      <label class="block text-lg font-bold text-gray-900 mb-4">過去に手術を受けたことはありますか？</label>

      <div class="flex space-x-6 mb-4">
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_surgeries", "true", @past_surgeries_array.any?,
              class: "form-radio h-6 w-6 text-green-600",
              data: { action: "questionnaire#toggleSurgeries" } %>
          <span class="ml-3 text-lg font-medium">あり</span>
        </label>
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_surgeries", "false", @past_surgeries_array.empty?,
              class: "form-radio h-6 w-6 text-green-600",
              data: { action: "questionnaire#toggleSurgeries" } %>
          <span class="ml-3 text-lg font-medium">なし</span>
        </label>
      </div>

      <div class="<%= @past_surgeries_array.any? ? '' : 'hidden' %> mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="surgeriesDetail">
        <label class="block text-sm font-medium text-gray-700 mb-2">手術内容と時期を教えてください：</label>
        <%= text_area_tag "surgery_details", "", rows: 3,
            class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
            placeholder: "例：虫垂炎手術（2015年）、帝王切開（2018年）" %>
      </div>

      <%# Hidden field for storing JSON data %>
      <%= form.hidden_field :past_surgeries, id: "past_surgeries_json" %>
    </div>

    <%# 2-5. 女性特有の質問 %>
    <div class="border-l-4 border-pink-400 pl-4">
      <label class="block text-lg font-bold text-gray-900 mb-4">女性特有の質問（該当する方のみ）</label>

      <div class="space-y-3">
        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "pregnancy_status[]", "pregnant", @pregnancy_info_array.include?("pregnant"), class: "form-checkbox h-5 w-5 text-pink-600" %>
          <span class="ml-3 text-base">現在妊娠中である</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "pregnancy_status[]", "breastfeeding", @pregnancy_info_array.include?("breastfeeding"), class: "form-checkbox h-5 w-5 text-pink-600" %>
          <span class="ml-3 text-base">現在授乳中である</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "pregnancy_status[]", "possible_pregnancy", @pregnancy_info_array.include?("possible_pregnancy"), class: "form-checkbox h-5 w-5 text-pink-600" %>
          <span class="ml-3 text-base">妊娠の可能性がある</span>
        </label>
      </div>

      <%# Hidden field for storing JSON data %>
      <%= form.hidden_field :pregnancy_info, id: "pregnancy_info_json" %>
    </div>
  </div>
</div>

<%# セクション3: 施術情報 %>
<div class="bg-white border-2 border-gray-200 rounded-lg p-6">
  <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-purple-500">施術情報</h2>

  <div class="space-y-8">
    <%# 3-1. 希望施術 %>
    <div class="border-l-4 border-purple-400 pl-4">
      <label class="block text-lg font-bold text-gray-900 mb-4">今回ご希望の施術を選択してください（複数選択可）：</label>

      <div class="space-y-3">
        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "desired_treatments[]", "eyebrow", @desired_treatments_array.include?("eyebrow"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">眉毛アートメイク</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "desired_treatments[]", "eyeliner_upper", @desired_treatments_array.include?("eyeliner_upper"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">アイラインアートメイク（上）</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "desired_treatments[]", "eyeliner_lower", @desired_treatments_array.include?("eyeliner_lower"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">アイラインアートメイク（下）</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "desired_treatments[]", "lip", @desired_treatments_array.include?("lip"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">リップアートメイク</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "desired_treatments[]", "hairline", @desired_treatments_array.include?("hairline"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">ヘアラインアートメイク</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "desired_treatments[]", "mole", @desired_treatments_array.include?("mole"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">ホクロ</span>
        </label>

        <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "has_other_treatment", "true", false,
              class: "form-checkbox h-5 w-5 text-purple-600 mt-1",
              data: { action: "questionnaire#toggleOtherTreatmentDetail" } %>
          <span class="ml-3 text-base">その他</span>
        </label>
        <div id="other_treatment_detail" class="hidden ml-8">
          <%= text_field_tag "other_treatment", "",
              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-base p-3",
              placeholder: "その他の施術を記入してください" %>
        </div>
      </div>

      <%# Hidden field for storing JSON data %>
      <%= form.hidden_field :desired_treatments, id: "desired_treatments_json" %>
    </div>

    <%# 3-2. アートメイク経験 %>
    <div class="border-l-4 border-purple-400 pl-4">
      <label class="block text-lg font-bold text-gray-900 mb-4">過去にアートメイクを受けたことはありますか？</label>

      <div class="flex space-x-6 mb-4">
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_past_treatments", "true", @past_treatments_array.any?,
              class: "form-radio h-6 w-6 text-purple-600",
              data: { action: "questionnaire#togglePastTreatments" } %>
          <span class="ml-3 text-lg font-medium">ある</span>
        </label>
        <label class="inline-flex items-center cursor-pointer">
          <%= radio_button_tag "has_past_treatments", "false", @past_treatments_array.empty?,
              class: "form-radio h-6 w-6 text-purple-600",
              data: { action: "questionnaire#togglePastTreatments" } %>
          <span class="ml-3 text-lg font-medium">ない</span>
        </label>
      </div>

      <div class="<%= @past_treatments_array.any? ? '' : 'hidden' %> mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="pastTreatmentsDetail">
        <p class="text-sm font-medium text-gray-700 mb-3">詳細を教えてください：</p>

        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">施術部位（複数選択可）：</label>
            <div class="flex flex-wrap gap-3">
              <label class="inline-flex items-center">
                <%= check_box_tag "past_treatment_parts[]", "eyebrow", @past_treatments_array.include?("eyebrow"), class: "form-checkbox h-4 w-4 text-purple-600" %>
                <span class="ml-2 text-sm">眉</span>
              </label>
              <label class="inline-flex items-center">
                <%= check_box_tag "past_treatment_parts[]", "eyeliner", @past_treatments_array.include?("eyeliner"), class: "form-checkbox h-4 w-4 text-purple-600" %>
                <span class="ml-2 text-sm">アイライン</span>
              </label>
              <label class="inline-flex items-center">
                <%= check_box_tag "past_treatment_parts[]", "lip", @past_treatments_array.include?("lip"), class: "form-checkbox h-4 w-4 text-purple-600" %>
                <span class="ml-2 text-sm">リップ</span>
              </label>
              <label class="inline-flex items-center">
                <%= check_box_tag "past_treatment_parts[]", "other", @past_treatments_array.include?("other"), class: "form-checkbox h-4 w-4 text-purple-600" %>
                <span class="ml-2 text-sm">その他</span>
              </label>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">施術時期：</label>
            <%= text_field_tag "past_treatment_date", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-base p-3",
                placeholder: "例：2022年3月頃" %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">施術場所：</label>
            <%= text_field_tag "past_treatment_location", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-base p-3",
                placeholder: "例：○○クリニック" %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">トラブルの有無：</label>
            <div class="flex space-x-4 mb-2">
              <label class="inline-flex items-center">
                <%= radio_button_tag "had_trouble", "false", true, class: "form-radio h-4 w-4 text-purple-600" %>
                <span class="ml-2 text-sm">なし</span>
              </label>
              <label class="inline-flex items-center">
                <%= radio_button_tag "had_trouble", "true", false, class: "form-radio h-4 w-4 text-purple-600" %>
                <span class="ml-2 text-sm">あり</span>
              </label>
            </div>
            <%= text_field_tag "trouble_detail", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-base p-3",
                placeholder: "トラブルの内容を記入してください（ある場合）" %>
          </div>
        </div>
      </div>

      <%# Hidden field for storing JSON data %>
      <%= form.hidden_field :past_treatments, id: "past_treatments_json" %>
    </div>

    <%# 3-3. 肌の状態 %>
    <div class="border-l-4 border-purple-400 pl-4">
      <label class="block text-lg font-bold text-gray-900 mb-4">以下に該当するものがありますか？（複数選択可）</label>

      <div class="space-y-3">
        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "skin_conditions[]", "keloid", @skin_conditions_array.include?("keloid"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">ケロイド体質</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "skin_conditions[]", "sensitive_skin", @skin_conditions_array.include?("sensitive_skin"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">肌が弱い・敏感肌</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "skin_conditions[]", "current_wound", @skin_conditions_array.include?("current_wound"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">現在、顔に傷や湿疹がある</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "skin_conditions[]", "herpes_prone", @skin_conditions_array.include?("herpes_prone"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">ヘルペスができやすい</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "skin_conditions[]", "sunburned", @skin_conditions_array.include?("sunburned"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">日焼けしている</span>
        </label>

        <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
          <%= check_box_tag "skin_conditions[]", "none", @skin_conditions_array.include?("none"), class: "form-checkbox h-5 w-5 text-purple-600" %>
          <span class="ml-3 text-base">該当なし</span>
        </label>
      </div>

      <%# Hidden field for storing JSON data %>
      <%= form.hidden_field :skin_conditions, id: "skin_conditions_json" %>
    </div>

    <%# 3-4. その他・相談事項 %>
    <div class="border-l-4 border-purple-400 pl-4">
      <label class="block text-lg font-bold text-gray-900 mb-4">その他、気になることやご相談がありましたらご記入ください：</label>

      <%= form.text_area :other_concerns, rows: 4,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-lg p-3",
          placeholder: "気になることやご質問があればご記入ください" %>
    </div>
  </div>
</div>
