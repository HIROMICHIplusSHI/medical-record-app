<%= form_with(model: questionnaire, url: patient_questionnaire_path(patient), local: true, class: "space-y-8", data: { controller: "questionnaire", action: "submit->questionnaire#handleSubmit" }) do |form| %>
  <% if questionnaire.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold mb-2"><%= pluralize(questionnaire.errors.count, "件") %>のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% questionnaire.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# セクション1: 基本情報 %>
  <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-blue-500">基本情報</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :full_name, "氏名（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :full_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "山田 太郎", required: true %>
      </div>

      <div>
        <%= form.label :full_name_kana, "フリガナ（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :full_name_kana, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "ヤマダ タロウ", required: true %>
      </div>

      <div>
        <%= form.label :birth_date, "生年月日（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.date_field :birth_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", required: true %>
      </div>

      <div>
        <%= form.label :gender, "性別（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="mt-2 space-y-2">
          <label class="inline-flex items-center mr-6">
            <%= form.radio_button :gender, "male", class: "form-radio h-5 w-5 text-blue-600" %>
            <span class="ml-2 text-lg">男性</span>
          </label>
          <label class="inline-flex items-center mr-6">
            <%= form.radio_button :gender, "female", class: "form-radio h-5 w-5 text-blue-600" %>
            <span class="ml-2 text-lg">女性</span>
          </label>
          <label class="inline-flex items-center mr-6">
            <%= form.radio_button :gender, "other", class: "form-radio h-5 w-5 text-blue-600" %>
            <span class="ml-2 text-lg">その他</span>
          </label>
          <label class="inline-flex items-center">
            <%= form.radio_button :gender, "prefer_not_to_say", class: "form-radio h-5 w-5 text-blue-600" %>
            <span class="ml-2 text-lg">回答しない</span>
          </label>
        </div>
      </div>

      <div>
        <%= form.label :phone, "電話番号（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.telephone_field :phone, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "090-1234-5678", required: true %>
      </div>

      <div>
        <%= form.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :email, type: :email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "example@email.com" %>
      </div>

      <div>
        <%= form.label :postal_code, "郵便番号", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :postal_code, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "123-4567" %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :address, "住所", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :address, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "東京都渋谷区..." %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :emergency_contact, "緊急連絡先", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :emergency_contact, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "本人以外の連絡先（氏名・続柄・電話番号）" %>
      </div>
    </div>
  </div>

  <%# セクション2&3: UI切り替え（フィーチャーフラグ） %>
  <% if @use_checkbox_ui %>
    <%= render 'form_checkbox', form: form %>
  <% else %>
    <%= render 'form_textarea', form: form %>
  <% end %>

  <div class="flex justify-end space-x-3 pt-4">
    <%= link_to "キャンセル", patient_path(patient), class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 px-6 rounded text-lg" %>
    <%= form.submit "保存", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded text-lg" %>
  </div>
<% end %>

<script>
  (function() {
    console.log('Questionnaire form script loaded');

    // フォームを取得
    const form = document.querySelector('form[data-controller="questionnaire"]');
    if (!form) {
      console.error('Form not found');
      return;
    }

    // フォーム送信イベントをリッスン
    form.addEventListener('submit', function(event) {
      console.log('Form submitting - processing checkboxes');

      // 既往歴・治療中の病気
      const medicalConditions = Array.from(form.querySelectorAll('input[name="medical_conditions[]"]:checked')).map(cb => cb.value);
      document.getElementById('medical_conditions_json').value = JSON.stringify(medicalConditions);
      console.log('Medical conditions:', medicalConditions);

      // アレルギー
      const allergies = Array.from(form.querySelectorAll('input[name="allergies[]"]:checked')).map(cb => cb.value);
      const drugAllergyDetail = document.getElementById('drug_allergy_detail_text');
      if (drugAllergyDetail && drugAllergyDetail.value.trim()) {
        allergies.push(`薬物: ${drugAllergyDetail.value.trim()}`);
      }
      const foodAllergyDetail = document.getElementById('food_allergy_detail_text');
      if (foodAllergyDetail && foodAllergyDetail.value.trim()) {
        allergies.push(`食物: ${foodAllergyDetail.value.trim()}`);
      }
      const otherAllergyDetail = document.getElementById('other_allergy_detail_text');
      if (otherAllergyDetail && otherAllergyDetail.value.trim()) {
        allergies.push(`その他: ${otherAllergyDetail.value.trim()}`);
      }
      document.getElementById('allergies_json').value = JSON.stringify(allergies);
      console.log('Allergies:', allergies);

      // 服薬中の薬
      const medications = Array.from(form.querySelectorAll('input[name="medications[]"]:checked')).map(cb => cb.value);
      const supplementDetail = document.getElementById('supplement_detail_text');
      if (supplementDetail && supplementDetail.value.trim()) {
        medications.push(`サプリメント: ${supplementDetail.value.trim()}`);
      }
      const otherMedicationDetail = document.getElementById('other_medication_detail_text');
      if (otherMedicationDetail && otherMedicationDetail.value.trim()) {
        medications.push(`その他: ${otherMedicationDetail.value.trim()}`);
      }
      document.getElementById('current_medications_json').value = JSON.stringify(medications);
      console.log('Medications:', medications);

      // 手術歴
      const surgeryDetail = document.getElementById('surgery_details');
      const surgeries = surgeryDetail && surgeryDetail.value.trim() ? [surgeryDetail.value.trim()] : [];
      document.getElementById('past_surgeries_json').value = JSON.stringify(surgeries);
      console.log('Surgeries:', surgeries);

      // 妊娠・授乳状況
      const pregnancy = Array.from(form.querySelectorAll('input[name="pregnancy_status[]"]:checked')).map(cb => cb.value);
      document.getElementById('pregnancy_info_json').value = JSON.stringify(pregnancy);
      console.log('Pregnancy:', pregnancy);

      // 希望施術部位
      const desiredTreatments = Array.from(form.querySelectorAll('input[name="desired_treatments[]"]:checked')).map(cb => cb.value);
      document.getElementById('desired_treatments_json').value = JSON.stringify(desiredTreatments);
      console.log('Desired treatments:', desiredTreatments);

      // 過去のアートメイク経験
      const pastTreatments = Array.from(form.querySelectorAll('input[name="past_treatment_parts[]"]:checked')).map(cb => cb.value);
      const otherTreatmentDetail = document.getElementById('other_treatment_detail_text');
      if (otherTreatmentDetail && otherTreatmentDetail.value.trim()) {
        pastTreatments.push(`その他: ${otherTreatmentDetail.value.trim()}`);
      }
      document.getElementById('past_treatments_json').value = JSON.stringify(pastTreatments);
      console.log('Past treatments:', pastTreatments);

      // 肌の状態
      const skinConditions = Array.from(form.querySelectorAll('input[name="skin_conditions[]"]:checked')).map(cb => cb.value);
      document.getElementById('skin_conditions_json').value = JSON.stringify(skinConditions);
      console.log('Skin conditions:', skinConditions);

      console.log('All checkbox data processed successfully');
    });

    console.log('Form submit handler attached');
  })();
</script>
