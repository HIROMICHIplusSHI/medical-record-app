<%= form_with(model: questionnaire, url: patient_questionnaire_path(patient), local: true, class: "space-y-8", data: { controller: "questionnaire" }) do |form| %>
  <% if questionnaire.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold mb-2"><%= pluralize(questionnaire.errors.count, "件") %>のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% questionnaire.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# セクション1: 基本情報 %>
  <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-blue-500">基本情報</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :full_name, "氏名（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :full_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "山田 太郎", required: true %>
      </div>

      <div>
        <%= form.label :full_name_kana, "フリガナ（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :full_name_kana, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "ヤマダ タロウ", required: true %>
      </div>

      <div>
        <%= form.label :birth_date, "生年月日（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.date_field :birth_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", required: true %>
      </div>

      <div>
        <%= form.label :gender, "性別（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="mt-2 space-y-2">
          <label class="inline-flex items-center mr-6">
            <%= form.radio_button :gender, "male", class: "form-radio h-5 w-5 text-blue-600" %>
            <span class="ml-2 text-lg">男性</span>
          </label>
          <label class="inline-flex items-center mr-6">
            <%= form.radio_button :gender, "female", class: "form-radio h-5 w-5 text-blue-600" %>
            <span class="ml-2 text-lg">女性</span>
          </label>
          <label class="inline-flex items-center mr-6">
            <%= form.radio_button :gender, "other", class: "form-radio h-5 w-5 text-blue-600" %>
            <span class="ml-2 text-lg">その他</span>
          </label>
          <label class="inline-flex items-center">
            <%= form.radio_button :gender, "prefer_not_to_say", class: "form-radio h-5 w-5 text-blue-600" %>
            <span class="ml-2 text-lg">回答しない</span>
          </label>
        </div>
      </div>

      <div>
        <%= form.label :phone, "電話番号（必須）", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.telephone_field :phone, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "090-1234-5678", required: true %>
      </div>

      <div>
        <%= form.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :email, type: :email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "example@email.com" %>
      </div>

      <div>
        <%= form.label :postal_code, "郵便番号", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :postal_code, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "123-4567" %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :address, "住所", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :address, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "東京都渋谷区..." %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :emergency_contact, "緊急連絡先", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :emergency_contact, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "本人以外の連絡先（氏名・続柄・電話番号）" %>
      </div>
    </div>
  </div>

  <%# セクション2: 医療情報 %>
  <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-green-500">医療情報</h2>

    <div class="space-y-8">
      <%# 2-1. 既往歴・治療中の病気 %>
      <div class="border-l-4 border-green-400 pl-4">
        <label class="block text-lg font-bold text-gray-900 mb-4">既往歴または現在治療中の病気はありますか？</label>

        <div class="flex space-x-6 mb-4">
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_medical_conditions", "true", false,
                class: "form-radio h-6 w-6 text-green-600",
                data: { action: "questionnaire#toggleMedicalConditions" } %>
            <span class="ml-3 text-lg font-medium">あり</span>
          </label>
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_medical_conditions", "false", true,
                class: "form-radio h-6 w-6 text-green-600",
                data: { action: "questionnaire#toggleMedicalConditions" } %>
            <span class="ml-3 text-lg font-medium">なし</span>
          </label>
        </div>

        <div class="hidden mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="medicalConditionsDetail">
          <p class="text-sm font-medium text-gray-700 mb-3">該当するものをすべて選択してください：</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "hypertension", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">高血圧</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "diabetes", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">糖尿病</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "dyslipidemia", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">脂質異常症（高脂血症）</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "liver_disease", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">肝機能障害</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "kidney_disease", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">腎機能障害</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "heart_disease", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">心疾患（不整脈、心筋梗塞など）</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "cerebrovascular_disease", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">脳血管疾患（脳梗塞、脳出血など）</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "thyroid_disease", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">甲状腺疾患</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "respiratory_disease", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">喘息・呼吸器疾患</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "epilepsy", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">てんかん</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "blood_disease", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">血液の病気（貧血、白血病など）</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "cancer", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">がん（現在治療中または過去の既往）</span>
            </label>
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medical_conditions[]", "autoimmune_disease", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">自己免疫疾患（関節リウマチ、膠原病など）</span>
            </label>
          </div>

          <div class="mt-4">
            <label class="flex items-start p-3 bg-white rounded border border-gray-200 cursor-pointer">
              <%= check_box_tag "has_other_condition", "true", false,
                  class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                  data: { action: "questionnaire#toggleOtherConditionDetail" } %>
              <span class="ml-3 text-base">その他</span>
            </label>
            <div id="other_condition_detail" class="hidden mt-2 ml-8">
              <%= text_field_tag "other_medical_condition", "",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                  placeholder: "その他の病気を記入してください" %>
            </div>
          </div>
        </div>

        <%# Hidden field for storing JSON data %>
        <%= form.hidden_field :medical_conditions, id: "medical_conditions_json" %>
      </div>

      <%# 2-2. アレルギー %>
      <div class="border-l-4 border-green-400 pl-4">
        <label class="block text-lg font-bold text-gray-900 mb-4">アレルギーはありますか？</label>

        <div class="flex space-x-6 mb-4">
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_allergies", "true", false,
                class: "form-radio h-6 w-6 text-green-600",
                data: { action: "questionnaire#toggleAllergies" } %>
            <span class="ml-3 text-lg font-medium">あり</span>
          </label>
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_allergies", "false", true,
                class: "form-radio h-6 w-6 text-green-600",
                data: { action: "questionnaire#toggleAllergies" } %>
            <span class="ml-3 text-lg font-medium">なし</span>
          </label>
        </div>

        <div class="hidden mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="allergiesDetail">
          <p class="text-sm font-medium text-gray-700 mb-3">該当するものをすべて選択してください：</p>
          <div class="space-y-3">
            <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "allergies[]", "drug_allergy", false,
                  class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                  data: { action: "questionnaire#toggleDrugAllergyDetail" } %>
              <span class="ml-3 text-base">薬物アレルギー</span>
            </label>
            <div id="drug_allergy_detail" class="hidden ml-8">
              <%= text_field_tag "drug_allergy_detail", "",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                  placeholder: "薬品名を記入してください（例：ペニシリン系）" %>
            </div>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "allergies[]", "metal_allergy", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">金属アレルギー</span>
            </label>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "allergies[]", "latex_allergy", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">ラテックスアレルギー</span>
            </label>

            <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "allergies[]", "food_allergy", false,
                  class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                  data: { action: "questionnaire#toggleFoodAllergyDetail" } %>
              <span class="ml-3 text-base">食物アレルギー</span>
            </label>
            <div id="food_allergy_detail" class="hidden ml-8">
              <%= text_field_tag "food_allergy_detail", "",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                  placeholder: "食品名を記入してください（例：そば、卵など）" %>
            </div>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "allergies[]", "hay_fever", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">花粉症</span>
            </label>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "allergies[]", "atopic_dermatitis", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">アトピー性皮膚炎</span>
            </label>

            <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "has_other_allergy", "true", false,
                  class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                  data: { action: "questionnaire#toggleOtherAllergyDetail" } %>
              <span class="ml-3 text-base">その他</span>
            </label>
            <div id="other_allergy_detail" class="hidden ml-8">
              <%= text_field_tag "other_allergy", "",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                  placeholder: "その他のアレルギーを記入してください" %>
            </div>
          </div>
        </div>

        <%# Hidden field for storing JSON data %>
        <%= form.hidden_field :allergies, id: "allergies_json" %>
      </div>

      <%# 2-3. 現在の服薬状況 %>
      <div class="border-l-4 border-green-400 pl-4">
        <label class="block text-lg font-bold text-gray-900 mb-4">現在、定期的に服用している薬はありますか？</label>

        <div class="flex space-x-6 mb-4">
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_medications", "true", false,
                class: "form-radio h-6 w-6 text-green-600",
                data: { action: "questionnaire#toggleMedications" } %>
            <span class="ml-3 text-lg font-medium">あり</span>
          </label>
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_medications", "false", true,
                class: "form-radio h-6 w-6 text-green-600",
                data: { action: "questionnaire#toggleMedications" } %>
            <span class="ml-3 text-lg font-medium">なし</span>
          </label>
        </div>

        <div class="hidden mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="medicationsDetail">
          <p class="text-sm font-medium text-gray-700 mb-3">該当するものをすべて選択してください：</p>
          <div class="space-y-3">
            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medications[]", "blood_pressure", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">血圧の薬</span>
            </label>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medications[]", "diabetes_medication", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">糖尿病の薬（インスリン含む）</span>
            </label>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medications[]", "anticoagulant", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">血液をサラサラにする薬（抗凝固薬・抗血小板薬）</span>
            </label>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medications[]", "steroid", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">ステロイド</span>
            </label>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medications[]", "immunosuppressant", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">免疫抑制剤</span>
            </label>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medications[]", "hormone", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">ホルモン剤</span>
            </label>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medications[]", "psychiatric_medication", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">精神科・心療内科の薬</span>
            </label>

            <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medications[]", "painkiller", false, class: "form-checkbox h-5 w-5 text-green-600" %>
              <span class="ml-3 text-base">痛み止め・鎮痛剤（常用）</span>
            </label>

            <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "medications[]", "supplement", false,
                  class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                  data: { action: "questionnaire#toggleSupplementDetail" } %>
              <span class="ml-3 text-base">サプリメント</span>
            </label>
            <div id="supplement_detail" class="hidden ml-8">
              <%= text_field_tag "supplement_detail", "",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                  placeholder: "サプリメント名を記入してください" %>
            </div>

            <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
              <%= check_box_tag "has_other_medication", "true", false,
                  class: "form-checkbox h-5 w-5 text-green-600 mt-1",
                  data: { action: "questionnaire#toggleOtherMedicationDetail" } %>
              <span class="ml-3 text-base">その他</span>
            </label>
            <div id="other_medication_detail" class="hidden ml-8">
              <%= text_field_tag "other_medication", "",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
                  placeholder: "その他の薬を記入してください" %>
            </div>
          </div>
        </div>

        <%# Hidden field for storing JSON data %>
        <%= form.hidden_field :current_medications, id: "current_medications_json" %>
      </div>

      <%# 2-4. 手術歴 %>
      <div class="border-l-4 border-green-400 pl-4">
        <label class="block text-lg font-bold text-gray-900 mb-4">過去に手術を受けたことはありますか？</label>

        <div class="flex space-x-6 mb-4">
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_surgeries", "true", false,
                class: "form-radio h-6 w-6 text-green-600",
                data: { action: "questionnaire#toggleSurgeries" } %>
            <span class="ml-3 text-lg font-medium">あり</span>
          </label>
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_surgeries", "false", true,
                class: "form-radio h-6 w-6 text-green-600",
                data: { action: "questionnaire#toggleSurgeries" } %>
            <span class="ml-3 text-lg font-medium">なし</span>
          </label>
        </div>

        <div class="hidden mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="surgeriesDetail">
          <label class="block text-sm font-medium text-gray-700 mb-2">手術内容と時期を教えてください：</label>
          <%= text_area_tag "surgery_details", "", rows: 3,
              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-base p-3",
              placeholder: "例：虫垂炎手術（2015年）、帝王切開（2018年）" %>
        </div>

        <%# Hidden field for storing JSON data %>
        <%= form.hidden_field :past_surgeries, id: "past_surgeries_json" %>
      </div>

      <%# 2-5. 女性特有の質問 %>
      <div class="border-l-4 border-pink-400 pl-4">
        <label class="block text-lg font-bold text-gray-900 mb-4">女性特有の質問（該当する方のみ）</label>

        <div class="space-y-3">
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "pregnancy_status[]", "pregnant", false, class: "form-checkbox h-5 w-5 text-pink-600" %>
            <span class="ml-3 text-base">現在妊娠中である</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "pregnancy_status[]", "breastfeeding", false, class: "form-checkbox h-5 w-5 text-pink-600" %>
            <span class="ml-3 text-base">現在授乳中である</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "pregnancy_status[]", "possible_pregnancy", false, class: "form-checkbox h-5 w-5 text-pink-600" %>
            <span class="ml-3 text-base">妊娠の可能性がある</span>
          </label>
        </div>

        <%# Hidden field for storing JSON data %>
        <%= form.hidden_field :pregnancy_info, id: "pregnancy_info_json" %>
      </div>
    </div>
  </div>

  <%# セクション3: 施術情報 %>
  <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-purple-500">施術情報</h2>

    <div class="space-y-8">
      <%# 3-1. 希望施術 %>
      <div class="border-l-4 border-purple-400 pl-4">
        <label class="block text-lg font-bold text-gray-900 mb-4">今回ご希望の施術を選択してください（複数選択可）：</label>

        <div class="space-y-3">
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "desired_treatments[]", "eyebrow", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">眉毛アートメイク</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "desired_treatments[]", "eyeliner_upper", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">アイラインアートメイク（上）</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "desired_treatments[]", "eyeliner_lower", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">アイラインアートメイク（下）</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "desired_treatments[]", "lip", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">リップアートメイク</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "desired_treatments[]", "hairline", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">ヘアラインアートメイク</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "desired_treatments[]", "mole", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">ホクロ</span>
          </label>

          <label class="flex items-start p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "has_other_treatment", "true", false,
                class: "form-checkbox h-5 w-5 text-purple-600 mt-1",
                data: { action: "questionnaire#toggleOtherTreatmentDetail" } %>
            <span class="ml-3 text-base">その他</span>
          </label>
          <div id="other_treatment_detail" class="hidden ml-8">
            <%= text_field_tag "other_treatment", "",
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-base p-3",
                placeholder: "その他の施術を記入してください" %>
          </div>
        </div>

        <%# Hidden field for storing JSON data %>
        <%= form.hidden_field :desired_treatments, id: "desired_treatments_json" %>
      </div>

      <%# 3-2. アートメイク経験 %>
      <div class="border-l-4 border-purple-400 pl-4">
        <label class="block text-lg font-bold text-gray-900 mb-4">過去にアートメイクを受けたことはありますか？</label>

        <div class="flex space-x-6 mb-4">
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_past_treatments", "true", false,
                class: "form-radio h-6 w-6 text-purple-600",
                data: { action: "questionnaire#togglePastTreatments" } %>
            <span class="ml-3 text-lg font-medium">ある</span>
          </label>
          <label class="inline-flex items-center cursor-pointer">
            <%= radio_button_tag "has_past_treatments", "false", true,
                class: "form-radio h-6 w-6 text-purple-600",
                data: { action: "questionnaire#togglePastTreatments" } %>
            <span class="ml-3 text-lg font-medium">ない</span>
          </label>
        </div>

        <div class="hidden mt-6 p-4 bg-gray-50 rounded-lg" data-questionnaire-target="pastTreatmentsDetail">
          <p class="text-sm font-medium text-gray-700 mb-3">詳細を教えてください：</p>

          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">施術部位（複数選択可）：</label>
              <div class="flex flex-wrap gap-3">
                <label class="inline-flex items-center">
                  <%= check_box_tag "past_treatment_parts[]", "eyebrow", false, class: "form-checkbox h-4 w-4 text-purple-600" %>
                  <span class="ml-2 text-sm">眉</span>
                </label>
                <label class="inline-flex items-center">
                  <%= check_box_tag "past_treatment_parts[]", "eyeliner", false, class: "form-checkbox h-4 w-4 text-purple-600" %>
                  <span class="ml-2 text-sm">アイライン</span>
                </label>
                <label class="inline-flex items-center">
                  <%= check_box_tag "past_treatment_parts[]", "lip", false, class: "form-checkbox h-4 w-4 text-purple-600" %>
                  <span class="ml-2 text-sm">リップ</span>
                </label>
                <label class="inline-flex items-center">
                  <%= check_box_tag "past_treatment_parts[]", "other", false, class: "form-checkbox h-4 w-4 text-purple-600" %>
                  <span class="ml-2 text-sm">その他</span>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">施術時期：</label>
              <%= text_field_tag "past_treatment_date", "",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-base p-3",
                  placeholder: "例：2022年3月頃" %>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">施術場所：</label>
              <%= text_field_tag "past_treatment_location", "",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-base p-3",
                  placeholder: "例：○○クリニック" %>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">トラブルの有無：</label>
              <div class="flex space-x-4 mb-2">
                <label class="inline-flex items-center">
                  <%= radio_button_tag "had_trouble", "false", true, class: "form-radio h-4 w-4 text-purple-600" %>
                  <span class="ml-2 text-sm">なし</span>
                </label>
                <label class="inline-flex items-center">
                  <%= radio_button_tag "had_trouble", "true", false, class: "form-radio h-4 w-4 text-purple-600" %>
                  <span class="ml-2 text-sm">あり</span>
                </label>
              </div>
              <%= text_field_tag "trouble_detail", "",
                  class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-base p-3",
                  placeholder: "トラブルの内容を記入してください（ある場合）" %>
            </div>
          </div>
        </div>

        <%# Hidden field for storing JSON data %>
        <%= form.hidden_field :past_treatments, id: "past_treatments_json" %>
      </div>

      <%# 3-3. 肌の状態 %>
      <div class="border-l-4 border-purple-400 pl-4">
        <label class="block text-lg font-bold text-gray-900 mb-4">以下に該当するものがありますか？（複数選択可）</label>

        <div class="space-y-3">
          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "skin_conditions[]", "keloid", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">ケロイド体質</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "skin_conditions[]", "sensitive_skin", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">肌が弱い・敏感肌</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "skin_conditions[]", "current_wound", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">現在、顔に傷や湿疹がある</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "skin_conditions[]", "herpes_prone", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">ヘルペスができやすい</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "skin_conditions[]", "sunburned", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">日焼けしている</span>
          </label>

          <label class="flex items-center p-3 bg-white rounded border border-gray-200 hover:bg-gray-50 cursor-pointer">
            <%= check_box_tag "skin_conditions[]", "none", false, class: "form-checkbox h-5 w-5 text-purple-600" %>
            <span class="ml-3 text-base">該当なし</span>
          </label>
        </div>

        <%# Hidden field for storing JSON data %>
        <%= form.hidden_field :skin_conditions, id: "skin_conditions_json" %>
      </div>

      <%# 3-4. その他・相談事項 %>
      <div class="border-l-4 border-purple-400 pl-4">
        <label class="block text-lg font-bold text-gray-900 mb-4">その他、気になることやご相談がありましたらご記入ください：</label>

        <%= form.text_area :other_concerns, rows: 4,
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500 text-lg p-3",
            placeholder: "気になることやご質問があればご記入ください" %>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3 pt-4">
    <%= link_to "キャンセル", patient_path(patient), class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 px-6 rounded text-lg" %>
    <%= form.submit "保存", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded text-lg" %>
  </div>
<% end %>
