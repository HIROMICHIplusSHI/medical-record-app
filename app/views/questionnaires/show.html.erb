<div class="py-6 sm:py-8">
  <div class="max-w-4xl mx-auto">
    <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">問診票</h1>
      <div class="flex flex-wrap gap-2 sm:gap-3">
        <% if session[:return_to_medical_record_id].present? %>
          <%= back_button "元のカルテに戻る", medical_record_path(session[:return_to_medical_record_id]) %>
        <% end %>
        <%= edit_button "編集", edit_patient_questionnaire_path(@patient) %>
        <%= cancel_button "患者詳細に戻る", patient_path(@patient) %>
      </div>
    </div>

    <%# セクション1: 基本情報 %>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <h2 class="text-2xl font-bold text-greige-900 mb-4 pb-2 border-b-2 border-blue-500">基本情報</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <dt class="text-sm font-medium text-greige-500">氏名</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(@questionnaire.full_name) %></dd>
        </div>

        <% if @questionnaire.full_name_kana.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">フリガナ</dt>
            <dd class="mt-1 text-lg text-greige-900"><%= h(@questionnaire.full_name_kana) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.birth_date.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">生年月日</dt>
            <dd class="mt-1 text-lg text-greige-900"><%= h(@questionnaire.birth_date) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.gender.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">性別</dt>
            <dd class="mt-1 text-lg text-greige-900">
              <%= h(case @questionnaire.gender
                    when 'male' then '男性'
                    when 'female' then '女性'
                    when 'other' then 'その他'
                    when 'prefer_not_to_say' then '回答しない'
                    else @questionnaire.gender
                    end) %>
            </dd>
          </div>
        <% end %>

        <div>
          <dt class="text-sm font-medium text-greige-500">電話番号</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(@questionnaire.phone) %></dd>
        </div>

        <% if @questionnaire.email.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">メールアドレス</dt>
            <dd class="mt-1 text-lg text-greige-900"><%= h(@questionnaire.email) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.postal_code.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">郵便番号</dt>
            <dd class="mt-1 text-lg text-greige-900"><%= h(@questionnaire.postal_code) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.address.present? %>
          <div class="md:col-span-2">
            <dt class="text-sm font-medium text-greige-500">住所</dt>
            <dd class="mt-1 text-lg text-greige-900"><%= h(@questionnaire.address) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.emergency_contact.present? %>
          <div class="md:col-span-2">
            <dt class="text-sm font-medium text-greige-500">緊急連絡先</dt>
            <dd class="mt-1 text-lg text-greige-900"><%= h(@questionnaire.emergency_contact) %></dd>
          </div>
        <% end %>
      </div>
    </div>

    <%# セクション2: 医療情報 %>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <h2 class="text-2xl font-bold text-greige-900 mb-4 pb-2 border-b-2 border-green-500">医療情報</h2>

      <div class="space-y-4">
        <% if @questionnaire.medical_conditions.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">既往歴・治療中の病気</dt>
            <dd class="mt-1 text-lg text-greige-900 whitespace-pre-wrap"><%= format_json_field(@questionnaire.medical_conditions) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.allergies.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">アレルギー</dt>
            <dd class="mt-1 text-lg text-greige-900 whitespace-pre-wrap"><%= format_json_field(@questionnaire.allergies) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.current_medications.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">服薬中の薬</dt>
            <dd class="mt-1 text-lg text-greige-900 whitespace-pre-wrap"><%= format_json_field(@questionnaire.current_medications) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.past_surgeries.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">手術歴</dt>
            <dd class="mt-1 text-lg text-greige-900 whitespace-pre-wrap"><%= format_json_field(@questionnaire.past_surgeries) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.pregnancy_info.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">妊娠・授乳状況</dt>
            <dd class="mt-1 text-lg text-greige-900 whitespace-pre-wrap"><%= format_json_field(@questionnaire.pregnancy_info) %></dd>
          </div>
        <% end %>
      </div>
    </div>

    <%# セクション3: 施術情報 %>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <h2 class="text-2xl font-bold text-greige-900 mb-4 pb-2 border-b-2 border-purple-500">施術情報</h2>

      <div class="space-y-4">
        <% if @questionnaire.desired_treatments.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">希望施術部位</dt>
            <dd class="mt-1 text-lg text-greige-900 whitespace-pre-wrap"><%= format_json_field(@questionnaire.desired_treatments) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.past_treatments.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">過去のアートメイク経験</dt>
            <dd class="mt-1 text-lg text-greige-900 whitespace-pre-wrap"><%= format_json_field(@questionnaire.past_treatments) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.skin_conditions.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">肌の状態</dt>
            <dd class="mt-1 text-lg text-greige-900 whitespace-pre-wrap"><%= format_json_field(@questionnaire.skin_conditions) %></dd>
          </div>
        <% end %>

        <% if @questionnaire.other_concerns.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-500">その他の気になること</dt>
            <dd class="mt-1 text-lg text-greige-900 whitespace-pre-wrap"><%= h(@questionnaire.other_concerns) %></dd>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 看護師確認セクション -->
    <div class="mt-6 bg-accent-warning/10 border border-accent-warning/30 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-greige-900 mb-4 flex items-center">
        <svg class="h-5 w-5 mr-2 text-accent-warning" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
        </svg>
        看護師確認
      </h3>
      <% if @questionnaire.nurse_confirmed? %>
        <div class="flex items-center text-accent-success">
          <svg class="h-6 w-6 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <div>
            <p class="font-medium">確認済み</p>
            <p class="text-sm text-greige-600">確認日時: <%= l @questionnaire.nurse_confirmed_at, format: :long %></p>
            <p class="text-sm text-greige-600">確認者: <%= @questionnaire.nurse_name %></p>
          </div>
        </div>
      <% else %>
        <div class="flex items-center text-greige-500">
          <svg class="h-6 w-6 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
          <p class="font-medium">未確認</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
