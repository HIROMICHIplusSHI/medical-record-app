<%# 旧UI: テキストエリア版（Phase 2-A） %>
<%# セクション2: 医療情報 %>
<div class="bg-white border-2 border-gray-200 rounded-lg p-6">
  <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-green-500">医療情報</h2>

  <div class="space-y-6">
    <div>
      <%= form.label :medical_conditions, "既往歴・治療中の病気", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :medical_conditions, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "例：高血圧、糖尿病など（ない場合は「なし」と記入）" %>
      <p class="mt-1 text-sm text-gray-500">※現在治療中の病気や過去の大きな病気があれば記入してください</p>
    </div>

    <div>
      <%= form.label :allergies, "アレルギー", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :allergies, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "例：薬物アレルギー、金属アレルギー、食物アレルギーなど" %>
    </div>

    <div>
      <%= form.label :current_medications, "現在の服薬状況", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :current_medications, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "例：血圧の薬、サプリメントなど" %>
    </div>

    <div>
      <%= form.label :past_surgeries, "過去の手術歴", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :past_surgeries, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "例：虫垂炎手術（2015年）" %>
    </div>

    <div>
      <%= form.label :pregnancy_info, "妊娠・授乳について（該当する方のみ）", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :pregnancy_info, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "妊娠中、授乳中、妊娠の可能性がある場合は記入してください" %>
    </div>
  </div>
</div>

<%# セクション3: 施術情報 %>
<div class="bg-white border-2 border-gray-200 rounded-lg p-6">
  <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-purple-500">施術情報</h2>

  <div class="space-y-6">
    <div>
      <%= form.label :desired_treatments, "今回ご希望の施術", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :desired_treatments, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "例：眉毛アートメイク、リップアートメイクなど" %>
    </div>

    <div>
      <%= form.label :past_treatments, "過去のアートメイク経験", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :past_treatments, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "例：2022年に眉のアートメイクを受けた（○○クリニック）" %>
    </div>

    <div>
      <%= form.label :skin_conditions, "肌の状態・気になること", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :skin_conditions, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "例：敏感肌、ケロイド体質、現在肌トラブルがあるなど" %>
    </div>

    <div>
      <%= form.label :other_concerns, "その他ご相談・ご質問", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :other_concerns, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg p-3", placeholder: "気になることやご質問があればご記入ください" %>
    </div>
  </div>
</div>
