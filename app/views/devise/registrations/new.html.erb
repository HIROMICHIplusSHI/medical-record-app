<div class="min-h-screen bg-gradient-to-br from-greige-50 to-greige-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <!-- InkFolioロゴ -->
    <div class="flex flex-col items-center space-y-4">
      <%= image_tag 'inkfolio-logo.svg', alt: 'InkFolio', class: 'h-16 w-auto' %>
      <p class="text-sm text-greige-600">新規アカウント登録</p>
    </div>

    <!-- 登録フォーム -->
    <div class="bg-white rounded-lg shadow-xl p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- メールアドレス -->
        <div>
          <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-greige-700 mb-2" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "appearance-none block w-full px-3 py-2 border border-greige-300 rounded-md shadow-sm placeholder-greige-400 focus:outline-none focus:ring-accent-primary focus:border-accent-primary sm:text-sm",
              placeholder: "you@example.com" %>
        </div>

        <!-- パスワード -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <%= f.label :password, "パスワード", class: "block text-sm font-medium text-greige-700" %>
            <% if @minimum_password_length %>
              <span class="text-xs text-greige-500">（<%= @minimum_password_length %>文字以上）</span>
            <% end %>
          </div>
          <%= f.password_field :password,
              autocomplete: "new-password",
              class: "appearance-none block w-full px-3 py-2 border border-greige-300 rounded-md shadow-sm placeholder-greige-400 focus:outline-none focus:ring-accent-primary focus:border-accent-primary sm:text-sm",
              placeholder: "••••••••" %>
        </div>

        <!-- パスワード確認 -->
        <div>
          <%= f.label :password_confirmation, "パスワード（確認）", class: "block text-sm font-medium text-greige-700 mb-2" %>
          <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "appearance-none block w-full px-3 py-2 border border-greige-300 rounded-md shadow-sm placeholder-greige-400 focus:outline-none focus:ring-accent-primary focus:border-accent-primary sm:text-sm",
              placeholder: "••••••••" %>
        </div>

        <!-- 登録ボタン -->
        <div>
          <%= f.submit "新規登録", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-accent-primary hover:bg-ink-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary transition-colors duration-200" %>
        </div>
      <% end %>

      <!-- リンク -->
      <div class="mt-6 text-center space-y-2">
        <%= link_to "既にアカウントをお持ちの方", new_session_path(resource_name), class: "text-sm text-accent-primary hover:text-ink-dark block" %>
      </div>
    </div>
  </div>
</div>
