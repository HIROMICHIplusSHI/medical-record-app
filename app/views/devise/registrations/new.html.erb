<div class="min-h-screen bg-gradient-to-br from-greige-50 via-white to-greige-50 flex items-center justify-center px-4 -mt-28 pt-28">
  <div class="w-full max-w-md">
    <!-- Logo Section -->
    <div class="text-center mb-8">
      <%= image_tag 'inkfolio-logo.svg', alt: 'InkFolio', class: 'h-24 w-auto mx-auto mb-6' %>
      <h1 class="text-2xl text-greige-800 tracking-wide mb-2" style="font-family: 'Shippori Mincho', serif; font-weight: 500;">
        新規アカウント登録
      </h1>
    </div>

    <!-- Registration Card -->
    <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-xl border border-greige-100 p-8 mb-6">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- メールアドレス -->
        <div>
          <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-greige-700 mb-2" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "appearance-none block w-full px-4 py-3 border border-greige-200 rounded-xl shadow-sm placeholder-greige-400 focus:outline-none focus:ring-2 focus:ring-accent-primary focus:border-transparent transition-all",
              placeholder: "you@example.com" %>
        </div>

        <!-- パスワード -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <%= f.label :password, "パスワード", class: "block text-sm font-medium text-greige-700" %>
            <% if @minimum_password_length %>
              <span class="text-xs text-greige-500">（<%= @minimum_password_length %>文字以上）</span>
            <% end %>
          </div>
          <%= f.password_field :password,
              autocomplete: "new-password",
              class: "appearance-none block w-full px-4 py-3 border border-greige-200 rounded-xl shadow-sm placeholder-greige-400 focus:outline-none focus:ring-2 focus:ring-accent-primary focus:border-transparent transition-all",
              placeholder: "••••••••" %>
        </div>

        <!-- パスワード確認 -->
        <div>
          <%= f.label :password_confirmation, "パスワード（確認）", class: "block text-sm font-medium text-greige-700 mb-2" %>
          <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "appearance-none block w-full px-4 py-3 border border-greige-200 rounded-xl shadow-sm placeholder-greige-400 focus:outline-none focus:ring-2 focus:ring-accent-primary focus:border-transparent transition-all",
              placeholder: "••••••••" %>
        </div>

        <!-- 登録ボタン -->
        <div class="mt-8">
          <%= f.submit "新規登録", class: "w-full py-3 px-4 bg-accent-primary text-white font-medium rounded-xl shadow-md hover:bg-accent-primary/90 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary transition-all duration-200" %>
        </div>
      <% end %>

      <!-- ログインリンク -->
      <div class="mt-6 text-center">
        <p class="text-sm text-greige-600">
          既にアカウントをお持ちの方は
          <%= link_to "ログイン", new_session_path(resource_name), class: "text-accent-primary hover:text-ink-dark font-medium transition-colors" %>
        </p>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center text-xs text-greige-500">
      &copy; <%= Time.current.year %> InkFolio. All rights reserved.
    </div>
  </div>
</div>
