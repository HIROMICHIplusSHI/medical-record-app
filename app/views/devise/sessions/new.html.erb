<div class="min-h-screen bg-gradient-to-br from-greige-50 to-greige-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <!-- InkFolioロゴ -->
    <div class="flex flex-col items-center space-y-4">
      <%= image_tag 'inkfolio-logo.svg', alt: 'InkFolio', class: 'h-16 w-auto' %>
      <p class="text-sm text-greige-600">アカウントにログイン</p>
    </div>

    <!-- ログインフォーム -->
    <div class="bg-white rounded-lg shadow-xl p-8">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <!-- メールアドレス -->
        <div>
          <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "appearance-none block w-full px-3 py-2 border border-greige-300 rounded-md shadow-sm placeholder-greige-400 focus:outline-none focus:ring-accent-primary focus:border-accent-primary sm:text-sm",
              placeholder: "you@example.com" %>
        </div>

        <!-- パスワード -->
        <div>
          <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "appearance-none block w-full px-3 py-2 border border-greige-300 rounded-md shadow-sm placeholder-greige-400 focus:outline-none focus:ring-accent-primary focus:border-accent-primary sm:text-sm",
              placeholder: "••••••••" %>
        </div>

        <!-- ログイン状態を保持 -->
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-accent-primary focus:ring-accent-primary border-greige-300 rounded" %>
            <%= f.label :remember_me, "ログイン状態を保持", class: "ml-2 block text-sm text-greige-700" %>
          </div>
        <% end %>

        <!-- ログインボタン -->
        <div>
          <%= f.submit "ログイン", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-accent-primary hover:bg-ink-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary transition-colors duration-200" %>
        </div>
      <% end %>

      <!-- リンク -->
      <div class="mt-6 text-center space-y-2">
        <%= link_to "新規登録", new_registration_path(resource_name), class: "text-sm text-accent-primary hover:text-ink-dark block" if devise_mapping.registerable? %>
        <%= link_to "パスワードをお忘れですか？", new_password_path(resource_name), class: "text-sm text-greige-600 hover:text-greige-700 block" if devise_mapping.recoverable? %>
      </div>
    </div>
  </div>
</div>
