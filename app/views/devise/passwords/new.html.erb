<div class="min-h-screen bg-gradient-to-br from-greige-50 to-greige-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <!-- InkFolioロゴ -->
    <div class="flex flex-col items-center space-y-4">
      <%= image_tag 'inkfolio-logo.svg', alt: 'InkFolio', class: 'h-16 w-auto' %>
      <p class="text-sm text-greige-600">パスワードをお忘れですか？</p>
    </div>

    <!-- パスワードリセットフォーム -->
    <div class="bg-white rounded-lg shadow-xl p-8">
      <p class="text-sm text-greige-600 mb-6">
        登録されたメールアドレスを入力してください。パスワードリセットの手順をお送りします。
      </p>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- メールアドレス -->
        <div>
          <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-greige-700 mb-2" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "appearance-none block w-full px-3 py-2 border border-greige-300 rounded-md shadow-sm placeholder-greige-400 focus:outline-none focus:ring-accent-primary focus:border-accent-primary sm:text-sm",
              placeholder: "you@example.com" %>
        </div>

        <!-- 送信ボタン -->
        <div>
          <%= f.submit "リセット手順を送信", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-accent-primary hover:bg-ink-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary transition-colors duration-200" %>
        </div>
      <% end %>

      <!-- リンク -->
      <div class="mt-6 text-center space-y-2">
        <%= link_to "ログインページに戻る", new_session_path(resource_name), class: "text-sm text-accent-primary hover:text-ink-dark block" %>
        <%= link_to "新規登録", new_registration_path(resource_name), class: "text-sm text-greige-600 hover:text-greige-700 block" if devise_mapping.registrable? %>
      </div>
    </div>
  </div>
</div>
