<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">マイページ設定</h1>
    <%= link_to "戻る", :back, class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <% if notice %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded p-6">
    <%= form_with(model: @user, url: mypage_path, method: :patch, local: true) do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <h3 class="font-bold">エラーが発生しました:</h3>
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- 発行者情報 -->
      <div class="mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">発行者情報</h2>
        <p class="text-sm text-gray-600 mb-4">請求書PDFの右上に表示される情報です。</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :company_name, '個人名・法人名', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= f.text_field :company_name, class: 'w-full px-3 py-2 border border-gray-300 rounded-md' %>
          </div>

          <div>
            <%= f.label :company_postal, '郵便番号', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= f.text_field :company_postal, placeholder: '123-4567', class: 'w-full px-3 py-2 border border-gray-300 rounded-md' %>
          </div>

          <div class="md:col-span-2">
            <%= f.label :company_address, '住所', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= f.text_area :company_address, rows: 2, class: 'w-full px-3 py-2 border border-gray-300 rounded-md' %>
          </div>

          <div>
            <%= f.label :company_phone, '電話番号', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= f.text_field :company_phone, placeholder: '03-1234-5678', class: 'w-full px-3 py-2 border border-gray-300 rounded-md' %>
          </div>

          <div>
            <%= f.label :company_email, 'メールアドレス', class: 'block text-sm font-medium text-gray-700 mb-1' %>
            <%= f.email_field :company_email, class: 'w-full px-3 py-2 border border-gray-300 rounded-md' %>
          </div>
        </div>
      </div>

      <!-- 振込先情報 -->
      <div class="mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">振込先情報</h2>
        <p class="text-sm text-gray-600 mb-4">請求書PDFに表示される振込先情報です。</p>

        <div>
          <%= f.label :bank_info, '振込先', class: 'block text-sm font-medium text-gray-700 mb-1' %>
          <p class="text-xs text-gray-500 mb-2">
            例: ○○銀行 ○○支店 普通口座 1234567<br>
            口座名義: ○○○○ (カ)
          </p>
          <%= f.text_area :bank_info, rows: 4, placeholder: "○○銀行 ○○支店 普通口座 0123456\n○○○○ (カ)\n振込期日: 2023年2月末", class: 'w-full px-3 py-2 border border-gray-300 rounded-md font-mono text-sm' %>
        </div>
      </div>

      <div class="flex justify-end">
        <%= f.submit '保存', class: 'bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded shadow' %>
      </div>
    <% end %>
  </div>
</div>
