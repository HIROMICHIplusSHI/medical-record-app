<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- ヘッダー -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">ホーム</h1>
    <p class="mt-2 text-sm text-gray-600">電子カルテアプリへようこそ</p>
  </div>

  <!-- お知らせセクション -->
  <% if @announcements.any? %>
    <div class="mb-8 space-y-4" data-controller="announcement">
      <% @announcements.each do |announcement| %>
        <% dismissed_ids = session[:dismissed_announcements] || [] %>
        <% next if dismissed_ids.include?(announcement.id) %>

        <div
          data-announcement-id="<%= announcement.id %>"
          class="<%= announcement_alert_class(announcement.severity) %> rounded-lg p-4 shadow-sm"
          role="alert"
        >
          <div class="flex">
            <div class="flex-shrink-0">
              <%= announcement_icon(announcement.severity) %>
            </div>
            <div class="ml-3 flex-1">
              <h3 class="text-sm font-medium <%= announcement_text_class(announcement.severity) %>">
                <%= announcement.title %>
              </h3>
              <div class="mt-2 text-sm <%= announcement_text_class(announcement.severity) %>">
                <%= simple_format(announcement.body) %>
              </div>
              <% if announcement.expires_at.present? %>
                <div class="mt-2 text-xs <%= announcement_text_class(announcement.severity) %> opacity-75">
                  有効期限: <%= l(announcement.expires_at, format: :long) %>
                </div>
              <% end %>
            </div>
            <div class="ml-auto pl-3">
              <button
                type="button"
                data-action="click->announcement#dismiss"
                data-announcement-id-param="<%= announcement.id %>"
                class="inline-flex <%= announcement_dismiss_class(announcement.severity) %> rounded-md p-1.5 focus:outline-none focus:ring-2 focus:ring-offset-2"
              >
                <span class="sr-only">閉じる</span>
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- クイックアクセスカード -->
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <!-- ダッシュボード -->
    <%= link_to dashboard_path, class: "block group" do %>
      <div class="bg-white overflow-hidden shadow-sm rounded-lg hover:shadow-md transition-shadow duration-200">
        <div class="p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-indigo-500 rounded-md p-3">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">売上ダッシュボード</dt>
                <dd class="mt-1 text-sm text-gray-900">売上・請求書の確認</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- カルテ管理 -->
    <%= link_to medical_records_path, class: "block group" do %>
      <div class="bg-white overflow-hidden shadow-sm rounded-lg hover:shadow-md transition-shadow duration-200">
        <div class="p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-green-500 rounded-md p-3">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">カルテ管理</dt>
                <dd class="mt-1 text-sm text-gray-900">カルテの作成・閲覧</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- 患者管理 -->
    <%= link_to patients_path, class: "block group" do %>
      <div class="bg-white overflow-hidden shadow-sm rounded-lg hover:shadow-md transition-shadow duration-200">
        <div class="p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-blue-500 rounded-md p-3">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">患者管理</dt>
                <dd class="mt-1 text-sm text-gray-900">患者情報の管理</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- 施術場所管理 -->
    <%= link_to facilities_path, class: "block group" do %>
      <div class="bg-white overflow-hidden shadow-sm rounded-lg hover:shadow-md transition-shadow duration-200">
        <div class="p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-purple-500 rounded-md p-3">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">施術場所管理</dt>
                <dd class="mt-1 text-sm text-gray-900">施設情報の管理</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- 請求書管理 -->
    <%= link_to invoices_path, class: "block group" do %>
      <div class="bg-white overflow-hidden shadow-sm rounded-lg hover:shadow-md transition-shadow duration-200">
        <div class="p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-yellow-500 rounded-md p-3">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">請求書管理</dt>
                <dd class="mt-1 text-sm text-gray-900">請求書の作成・管理</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- 同意書テンプレート -->
    <%= link_to consent_form_templates_path, class: "block group" do %>
      <div class="bg-white overflow-hidden shadow-sm rounded-lg hover:shadow-md transition-shadow duration-200">
        <div class="p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-red-500 rounded-md p-3">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">同意書テンプレート</dt>
                <dd class="mt-1 text-sm text-gray-900">テンプレートの管理</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
