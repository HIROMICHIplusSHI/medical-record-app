<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">売上ダッシュボード</h1>
    <%= link_to "CSV出力", export_dashboard_path(format: :csv, start_date: @start_date, end_date: @end_date),
                class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
  </div>

  <!-- 期間選択フォーム -->
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <%= form_with url: dashboard_path, method: :get, local: true, class: "flex gap-4 items-end" do |f| %>
      <div>
        <%= f.label :start_date, "開始日", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :start_date, value: @start_date, class: "border rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :end_date, "終了日", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :end_date, value: @end_date, class: "border rounded px-3 py-2" %>
      </div>
      <%= f.submit "表示", class: "bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700" %>
    <% end %>
  </div>

  <!-- 総売上 -->
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-xl font-bold text-gray-900 mb-4">期間売上</h2>
    <p class="text-sm text-gray-600 mb-2">
      <%= @start_date.strftime("%Y年%m月%d日") %> 〜 <%= @end_date.strftime("%Y年%m月%d日") %>
    </p>
    <p class="text-4xl font-bold text-blue-600">
      ¥<%= number_with_delimiter(@total_revenue) %>
    </p>
  </div>

  <!-- 施設別売上 -->
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-xl font-bold text-gray-900 mb-4">施設別売上</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">施設名</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">売上金額</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @facility_data.each do |facility| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= facility.name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right">
                ¥<%= number_with_delimiter(facility.revenue) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 月次売上 -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-4">月次売上推移</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">月</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">売上金額</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">カルテ件数</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @monthly_data.each do |data| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= data[:month] %>月
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right">
                ¥<%= number_with_delimiter(data[:revenue]) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right">
                <%= data[:count] %>件
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
