<div class="py-6 sm:py-8">
  <%= patient_breadcrumb @patient %>

  <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">患者詳細</h1>
    <div class="flex flex-wrap gap-2 sm:gap-3">
      <%= edit_button "編集", edit_patient_path(@patient) %>
      <%= back_button "一覧に戻る", patients_path %>
    </div>
  </div>

  <% if notice %>
    <div class="bg-accent-success/10 border border-accent-success text-accent-success px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded p-6">
    <% if @patient.questionnaire.present? %>
      <%# 問診票が存在する場合は問診票から基本情報を表示 %>
      <% questionnaire = @patient.questionnaire %>
      <div class="bg-accent-primary/10 border border-accent-primary rounded p-3 mb-4">
        <p class="text-sm text-ink-dark">基本情報は問診票から取得されています。変更する場合は問診票を編集してください。</p>
      </div>
      <dl class="grid grid-cols-1 gap-6">
        <div>
          <dt class="text-sm font-medium text-gray-500">氏名</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(questionnaire.full_name) %></dd>
        </div>

        <% if questionnaire.full_name_kana.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">フリガナ</dt>
            <dd class="mt-1 text-lg text-gray-900"><%= h(questionnaire.full_name_kana) %></dd>
          </div>
        <% end %>

        <div>
          <dt class="text-sm font-medium text-gray-500">生年月日</dt>
          <dd class="mt-1 text-lg text-gray-900">
            <%= h(if questionnaire.birth_date.present?
                    begin
                      Date.parse(questionnaire.birth_date.to_s).strftime('%Y年%m月%d日')
                    rescue
                      questionnaire.birth_date
                    end
                  else
                    "未登録"
                  end) %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">性別</dt>
          <dd class="mt-1 text-lg text-gray-900">
            <%= h(case questionnaire.gender
                  when 'male' then '男性'
                  when 'female' then '女性'
                  when 'other' then 'その他'
                  when 'prefer_not_to_say' then '回答しない'
                  else "未登録"
                  end) %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">電話番号</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(questionnaire.phone) %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">メールアドレス</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(questionnaire.email || "未登録") %></dd>
        </div>

        <% if questionnaire.postal_code.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">郵便番号</dt>
            <dd class="mt-1 text-lg text-gray-900"><%= h(questionnaire.postal_code) %></dd>
          </div>
        <% end %>

        <div>
          <dt class="text-sm font-medium text-gray-500">住所</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(questionnaire.address || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">緊急連絡先</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(questionnaire.emergency_contact || "未登録") %></dd>
        </div>
      </dl>
    <% else %>
      <%# 問診票が存在しない場合は患者レコードから表示 %>
      <dl class="grid grid-cols-1 gap-6">
        <div>
          <dt class="text-sm font-medium text-gray-500">氏名</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(@patient.name) %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">生年月日</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(@patient.date_of_birth&.strftime('%Y年%m月%d日') || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">性別</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(t("activerecord.attributes.patient.genders.#{@patient.gender}")) %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">電話番号</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(@patient.phone || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">メールアドレス</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(@patient.email || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">住所</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(@patient.address || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">緊急連絡先</dt>
          <dd class="mt-1 text-lg text-gray-900"><%= h(@patient.emergency_contact || "未登録") %></dd>
        </div>
      </dl>
    <% end %>

    <dl class="grid grid-cols-1 gap-6 mt-6">
      <div>
        <dt class="text-sm font-medium text-gray-500">登録日時</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= l @patient.created_at, format: :long %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">更新日時</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= l @patient.updated_at, format: :long %></dd>
      </div>
    </dl>

    <div class="mt-6 pt-6 border-t border-greige-200">
      <h2 class="text-xl font-bold text-greige-900 mb-4">問診票</h2>
      <% if @patient.questionnaire.present? %>
        <div class="flex flex-wrap gap-2 sm:gap-3">
          <%= show_button "問診票を表示", patient_questionnaire_path(@patient) %>
          <%= edit_button "問診票を編集", edit_patient_questionnaire_path(@patient) %>
          <%= delete_button "問診票を削除", patient_questionnaire_path(@patient) %>
        </div>
      <% else %>
        <p class="text-greige-600 mb-4">まだ問診票が登録されていません。</p>
        <%= new_button "問診票を作成", new_patient_questionnaire_path(@patient) %>
      <% end %>
    </div>

    <%= render "patients/treatment_history",
               patient: @patient,
               recent_medical_records: @recent_medical_records,
               medical_records_count: @medical_records_count %>

    <div class="mt-6 pt-6 border-t border-greige-200">
      <%= delete_button "この患者を削除", @patient, data: { turbo_confirm: "本当に削除しますか？この操作は取り消せません。" } %>
    </div>
  </div>
</div>
