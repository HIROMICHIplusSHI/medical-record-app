<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">患者詳細</h1>
    <div>
      <%= link_to "編集", edit_patient_path(@patient), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mr-2" %>
      <%= link_to "一覧に戻る", patients_path, class: "bg-greige-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <% if notice %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded p-6">
    <% if @patient.questionnaire.present? %>
      <%# 問診票が存在する場合は問診票から基本情報を表示 %>
      <% questionnaire = @patient.questionnaire %>
      <div class="bg-blue-50 border border-blue-200 rounded p-3 mb-4">
        <p class="text-sm text-blue-800">基本情報は問診票から取得されています。変更する場合は問診票を編集してください。</p>
      </div>
      <dl class="grid grid-cols-1 gap-6">
        <div>
          <dt class="text-sm font-medium text-greige-600">氏名</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(questionnaire.full_name) %></dd>
        </div>

        <% if questionnaire.full_name_kana.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-600">フリガナ</dt>
            <dd class="mt-1 text-lg text-greige-900"><%= h(questionnaire.full_name_kana) %></dd>
          </div>
        <% end %>

        <div>
          <dt class="text-sm font-medium text-greige-600">生年月日</dt>
          <dd class="mt-1 text-lg text-greige-900">
            <%= h(if questionnaire.birth_date.present?
                    begin
                      Date.parse(questionnaire.birth_date.to_s).strftime('%Y年%m月%d日')
                    rescue
                      questionnaire.birth_date
                    end
                  else
                    "未登録"
                  end) %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">性別</dt>
          <dd class="mt-1 text-lg text-greige-900">
            <%= h(case questionnaire.gender
                  when 'male' then '男性'
                  when 'female' then '女性'
                  when 'other' then 'その他'
                  when 'prefer_not_to_say' then '回答しない'
                  else "未登録"
                  end) %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">電話番号</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(questionnaire.phone) %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">メールアドレス</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(questionnaire.email || "未登録") %></dd>
        </div>

        <% if questionnaire.postal_code.present? %>
          <div>
            <dt class="text-sm font-medium text-greige-600">郵便番号</dt>
            <dd class="mt-1 text-lg text-greige-900"><%= h(questionnaire.postal_code) %></dd>
          </div>
        <% end %>

        <div>
          <dt class="text-sm font-medium text-greige-600">住所</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(questionnaire.address || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">緊急連絡先</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(questionnaire.emergency_contact || "未登録") %></dd>
        </div>
      </dl>
    <% else %>
      <%# 問診票が存在しない場合は患者レコードから表示 %>
      <dl class="grid grid-cols-1 gap-6">
        <div>
          <dt class="text-sm font-medium text-greige-600">氏名</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(@patient.name) %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">生年月日</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(@patient.date_of_birth&.strftime('%Y年%m月%d日') || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">性別</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(t("activerecord.attributes.patient.genders.#{@patient.gender}")) %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">電話番号</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(@patient.phone || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">メールアドレス</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(@patient.email || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">住所</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(@patient.address || "未登録") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-greige-600">緊急連絡先</dt>
          <dd class="mt-1 text-lg text-greige-900"><%= h(@patient.emergency_contact || "未登録") %></dd>
        </div>
      </dl>
    <% end %>

      <div>
        <dt class="text-sm font-medium text-greige-600">登録日時</dt>
        <dd class="mt-1 text-lg text-greige-900"><%= l @patient.created_at, format: :long %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-greige-600">更新日時</dt>
        <dd class="mt-1 text-lg text-greige-900"><%= l @patient.updated_at, format: :long %></dd>
      </div>
    </dl>

    <div class="mt-6 pt-6 border-t border-greige-200">
      <h2 class="text-xl font-bold text-greige-900 mb-4">問診票</h2>
      <% if @patient.questionnaire.present? %>
        <div class="flex space-x-3">
          <%= link_to "問診票を表示", patient_questionnaire_path(@patient), class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
          <%= link_to "問診票を編集", edit_patient_questionnaire_path(@patient), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
          <%= button_to "問診票を削除", patient_questionnaire_path(@patient), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded" %>
        </div>
      <% else %>
        <p class="text-greige-600 mb-4">まだ問診票が登録されていません。</p>
        <%= link_to "問診票を作成", new_patient_questionnaire_path(@patient), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
    </div>

    <div class="mt-6 pt-6 border-t border-greige-200">
      <%= button_to "この患者を削除", @patient, method: :delete, data: { turbo_confirm: "本当に削除しますか？この操作は取り消せません。" }, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>
</div>
