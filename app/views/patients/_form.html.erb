<%= form_with(model: patient, local: true, class: "space-y-6") do |form| %>
  <% if patient.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold mb-2"><%= pluralize(patient.errors.count, "件") %>のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% patient.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "氏名", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：山田太郎", required: true %>
  </div>

  <div>
    <%= form.label :date_of_birth, "生年月日", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.date_field :date_of_birth, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :gender, "性別", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.select :gender,
        Patient.genders.keys.map { |key| [t("activerecord.attributes.patient.genders.#{key}"), key] },
        { prompt: "選択してください" },
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :phone, "電話番号", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :phone, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：090-1234-5678" %>
  </div>

  <div>
    <%= form.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.email_field :email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：patient@example.com" %>
  </div>

  <div>
    <%= form.label :address, "住所", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_area :address, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：東京都渋谷区1-1-1" %>
  </div>

  <div>
    <%= form.label :emergency_contact, "緊急連絡先", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :emergency_contact, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", placeholder: "例：03-1234-5678" %>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "キャンセル", patients_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded" %>
    <%= form.submit "保存", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>
<% end %>
