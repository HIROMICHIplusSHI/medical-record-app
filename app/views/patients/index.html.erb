<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">患者一覧</h1>
    <%= link_to "新しい患者を登録", new_patient_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <% if notice %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
      <%= notice %>
    </div>
  <% end %>

  <% if @patients.any? %>
    <div class="bg-white shadow-md rounded">
      <table class="min-w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">氏名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">生年月日</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">性別</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">電話番号</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @patients.each do |patient| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to patient.name, patient, class: "text-blue-600 hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4"><%= patient.date_of_birth&.strftime('%Y年%m月%d日') %></td>
              <td class="px-6 py-4"><%= t("activerecord.attributes.patient.genders.#{patient.gender}") %></td>
              <td class="px-6 py-4"><%= patient.phone %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= link_to "表示", patient, class: "text-blue-600 hover:text-blue-900 mr-3" %>
                <%= link_to "編集", edit_patient_path(patient), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
                <%= button_to "削除", patient, method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "text-red-600 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded p-8 text-center">
      <p class="text-gray-600 mb-4">まだ患者が登録されていません。</p>
      <%= link_to "最初の患者を登録する", new_patient_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  <% end %>
</div>
