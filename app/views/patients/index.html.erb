<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">患者一覧</h1>
    <%= new_button "新しい患者を登録", new_patient_path %>
  </div>

  <% if notice %>
    <div class="bg-accent-success/10 border border-accent-success text-accent-success px-4 py-3 rounded transition-colors mb-4">
      <%= notice %>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form_with url: patients_path, method: :get, local: true, class: "flex gap-2" do |form| %>
      <%= form.text_field :query, value: params[:query], placeholder: "氏名または電話番号で検索", class: "flex-1 rounded-lg border-gray-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary text-lg p-3" %>
      <%= search_button "検索" %>
      <% if params[:query].present? %>
        <%= clear_button "クリア", patients_path %>
      <% end %>
    <% end %>
  </div>

  <% if @patients.any? %>
    <div class="bg-white shadow-md rounded transition-colors">
      <table class="min-w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">氏名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">生年月日</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">性別</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">電話番号</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @patients.each do |patient| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to patient.name, patient, class: "text-ink-dark hover:text-accent-primary transition-colors" %>
              </td>
              <td class="px-6 py-4"><%= patient.date_of_birth&.strftime('%Y年%m月%d日') %></td>
              <td class="px-6 py-4"><%= t("activerecord.attributes.patient.genders.#{patient.gender}") %></td>
              <td class="px-6 py-4"><%= patient.phone %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                <%= show_button "表示", patient %>
                <%= edit_button "編集", edit_patient_path(patient) %>
                <%= delete_button "削除", patient %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex justify-center">
      <%= paginate @patients, params: { query: params[:query] } %>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded transition-colors p-8 text-center">
      <p class="text-greige-600 mb-4">まだ患者が登録されていません。</p>
      <%= new_button "最初の患者を登録する", new_patient_path %>
    </div>
  <% end %>
</div>
