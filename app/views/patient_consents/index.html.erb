<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">同意書一覧</h1>
    <p class="mt-2 text-sm text-gray-600">
      カルテ #<%= @medical_record.id %> - <%= @medical_record.patient.name %>様
    </p>
  </div>

  <% if @patient_consents.any? %>
    <div class="space-y-4">
      <% @patient_consents.each do |consent| %>
        <div class="bg-white shadow-md rounded-lg p-6" data-consent-id="<%= consent.id %>">
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <h2 class="text-xl font-bold text-gray-900"><%= consent.consent_form_template.title %></h2>
              <div class="mt-3 text-sm text-gray-600 space-y-1">
                <p><strong>署名日時:</strong> <%= l consent.agreed_at, format: :long %></p>
                <% if consent.facility_doctor.present? %>
                  <p><strong>担当医師:</strong> <%= consent.facility_doctor.name %>（<%= consent.facility_doctor.license_number %>）</p>
                <% end %>
                <p><strong>施設:</strong> <%= consent.facility_name %></p>
                <p><strong>施術者:</strong> <%= consent.practitioner_name %></p>
              </div>
            </div>
            <div class="ml-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                署名済み
              </span>
            </div>
          </div>

          <!-- チェック項目表示 -->
          <div class="mt-4 border-t pt-4">
            <h3 class="text-sm font-medium text-gray-700 mb-2">確認事項</h3>
            <ul class="space-y-1">
              <% consent.consent_item_responses.includes(:consent_form_item).each do |response| %>
                <li class="text-sm text-gray-600 flex items-center">
                  <% if response.checked %>
                    <svg class="h-4 w-4 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  <% else %>
                    <svg class="h-4 w-4 text-gray-300 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  <% end %>
                  <%= response.consent_form_item.content %>
                </li>
              <% end %>
            </ul>
          </div>

          <!-- アクションボタン -->
          <div class="mt-4 flex gap-2">
            <%= link_to '詳細', medical_record_patient_consent_path(@medical_record, consent), class: "inline-flex items-center px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-50 rounded-lg p-8 text-center">
      <p class="text-gray-600">同意書はまだ作成されていません。</p>
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to 'カルテに戻る', medical_record_path(@medical_record), class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
  </div>
</div>
