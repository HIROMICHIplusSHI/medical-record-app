<div class="py-6 sm:py-8" data-controller="consent-forms">
  <%= medical_record_breadcrumb @medical_record, ['同意書', medical_record_patient_consents_path(@medical_record)], '新規作成' %>

  <div class="mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-greige-900">同意書作成</h1>
    <p class="mt-2 text-sm text-greige-600">
      施術記録 #<%= @medical_record.id %> - <%= @medical_record.patient.name %>様
    </p>
  </div>

  <!-- ステップインジケーター -->
  <div class="mb-8">
    <div class="flex items-center justify-center gap-2">
      <div class="flex items-center">
        <div data-consent-forms-target="stepIndicator1" class="flex items-center justify-center w-10 h-10 rounded-full bg-accent-primary text-white font-semibold">
          1
        </div>
        <span class="ml-2 text-sm font-medium text-greige-700">施術者による準備</span>
      </div>
      <div class="mx-4 h-0.5 w-16 bg-greige-300"></div>
      <div class="flex items-center">
        <div data-consent-forms-target="stepIndicator2" class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-200 text-greige-600 font-semibold">
          2
        </div>
        <span class="ml-2 text-sm font-medium text-greige-700">患者確認・署名</span>
      </div>
    </div>
  </div>

  <% if flash[:alert] %>
    <div class="bg-accent-danger/10 border border-accent-danger text-accent-danger px-4 py-3 rounded mb-4">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: medical_record_patient_consents_path(@medical_record), method: :post, local: true, class: "space-y-6" do |f| %>

    <!-- Step 1: 施術者による準備 -->
    <div data-consent-forms-target="step1Content">
      <div class="bg-white shadow-md rounded-lg p-4 sm:p-6">
        <h2 class="text-xl font-bold text-greige-900 mb-2">Step 1: 施術者による準備</h2>
        <p class="text-sm text-greige-600 mb-4">使用する同意書テンプレートを選択し、担当医師を指定してください。</p>

        <% if @consent_form_templates.any? %>
          <div class="space-y-4">
            <% @consent_form_templates.each_with_index do |template, index| %>
              <div class="border border-greige-200 rounded-lg p-3 sm:p-4">
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <%= check_box_tag "patient_consents[#{index}][selected]", "1", false,
                        id: "consent_template_#{template.id}",
                        class: "h-4 w-4 text-accent-primary focus:ring-accent-primary border-greige-300 rounded",
                        data: {
                          action: "change->consent-forms#toggleTemplate",
                          consent_forms_target: "checkbox",
                          template_id: template.id
                        } %>
                  </div>
                  <div class="ml-3 flex-1">
                    <label for="consent_template_<%= template.id %>" class="font-medium text-greige-900 cursor-pointer">
                      <%= template.title %>
                    </label>
                    <% if template.description.present? %>
                      <p class="text-sm text-greige-600 mt-1 whitespace-pre-line"><%= template.description %></p>
                    <% end %>
                    <p class="text-xs text-greige-500 mt-1">
                      チェック項目: <%= template.consent_form_items.count %>件
                      （必須: <%= template.consent_form_items.where(is_required: true).count %>件）
                    </p>
                  </div>
                </div>

                <!-- 医師選択フォーム（選択時に表示） -->
                <div class="mt-4 hidden"
                     data-consent-forms-target="form"
                     data-template-id="<%= template.id %>">
                  <%= hidden_field_tag "patient_consents[#{index}][consent_form_template_id]", template.id %>

                  <div class="bg-greige-50 rounded-lg p-4">
                    <h3 class="font-semibold text-greige-900 mb-3">担当医師を選択</h3>

                    <!-- 医師選択 -->
                    <div>
                      <label class="block text-sm font-medium text-greige-700 mb-2">
                        担当医師（任意）
                      </label>
                      <%= select_tag "patient_consents[#{index}][facility_doctor_id]",
                          options_from_collection_for_select(@facility_doctors, :id, :name_with_license),
                          prompt: '医師を選択してください',
                          class: "mt-1 block w-full py-2 px-3 border border-greige-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-accent-primary focus:border-accent-primary sm:text-sm",
                          data: { controller: 'tom-select' },
                          required: false %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <!-- 患者に渡すボタン -->
          <div class="mt-6 flex justify-end">
            <button
              type="button"
              data-action="click->consent-forms#goToStep2"
              data-consent-forms-target="nextButton"
              disabled
              class="px-6 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-accent-primary hover:bg-accent-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary disabled:bg-greige-400 disabled:cursor-not-allowed">
              患者に渡す →
            </button>
          </div>
        <% else %>
          <p class="text-greige-600 text-center py-8">
            同意書テンプレートが登録されていません。<br>
            <%= link_to '新しいテンプレートを作成', new_consent_form_template_path, class: "text-accent-primary hover:text-accent-primary/90 transition-colors underline" %>
          </p>
        <% end %>
      </div>
    </div>

    <!-- Step 2: 患者確認・署名 -->
    <div data-consent-forms-target="step2Content" class="hidden">
      <div class="bg-white shadow-md rounded-lg p-4 sm:p-6">
        <h2 class="text-xl font-bold text-greige-900 mb-2">Step 2: 患者確認・署名</h2>
        <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6">
          <p class="text-sm text-blue-800">
            <strong>患者様へ：</strong>以下の内容をご確認いただき、同意される場合は各項目にチェックを入れ、署名をお願いします。
          </p>
        </div>

        <% if @consent_form_templates.any? %>
          <div class="space-y-6">
            <% @consent_form_templates.each_with_index do |template, index| %>
              <!-- 各テンプレートの患者確認セクション -->
              <div class="border border-greige-300 rounded-lg p-3 sm:p-4 hidden"
                   data-consent-forms-target="patientSection"
                   data-template-id="<%= template.id %>">
                <h3 class="text-lg font-bold text-greige-900 mb-3"><%= template.title %></h3>

                <!-- チェック項目 -->
                <div class="mb-4">
                  <label class="block text-sm font-medium text-greige-700 mb-3">
                    確認事項 <span class="text-xs text-greige-500">（必須項目は必ずチェックしてください）</span>
                  </label>
                  <div class="space-y-2">
                    <% template.consent_form_items.order(:position).each_with_index do |item, item_index| %>
                      <%= hidden_field_tag "patient_consents[#{index}][consent_item_responses_attributes][#{item_index}][consent_form_item_id]", item.id %>
                      <div class="flex items-start">
                        <div class="flex items-center h-5">
                          <%= check_box_tag "patient_consents[#{index}][consent_item_responses_attributes][#{item_index}][checked]",
                              "1", false,
                              class: "h-4 w-4 text-accent-primary focus:ring-accent-primary border-greige-300 rounded",
                              required: item.is_required? %>
                        </div>
                        <div class="ml-3">
                          <label class="text-sm text-greige-900 whitespace-pre-line">
                            <%= item.content %>
                            <% if item.is_required? %>
                              <span class="text-red-500">*</span>
                            <% end %>
                          </label>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>

                <!-- 署名エリア -->
                <div class="mb-4" data-controller="signature">
                  <label class="block text-sm font-medium text-greige-700 mb-2">
                    患者署名 <span class="text-red-500">*</span>
                  </label>
                  <div class="border-2 border-greige-300 rounded-lg p-2 bg-white">
                    <canvas
                      data-signature-target="canvas"
                      class="w-full border border-greige-200 rounded cursor-crosshair"
                      style="height: 200px; touch-action: none;">
                    </canvas>
                    <%= hidden_field_tag "patient_consents[#{index}][signature_data]", "",
                        data: { signature_target: "hiddenField" },
                        required: true %>
                    <div class="mt-2 flex justify-end">
                      <button
                        type="button"
                        data-signature-target="clearButton"
                        data-action="click->signature#clear"
                        class="px-3 py-1 text-sm bg-gray-200 hover:bg-greige-300 text-greige-700 rounded disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled>
                        クリア
                      </button>
                    </div>
                  </div>
                  <p class="mt-1 text-xs text-greige-500">
                    ※ 上記のキャンバス内に署名してください
                  </p>
                </div>

                <!-- 看護師確認 -->
                <div class="mb-4 bg-yellow-50 border-2 border-yellow-200 rounded-lg p-4">
                  <div class="flex items-start">
                    <div class="flex items-center h-5 mt-0.5">
                      <%= check_box_tag "patient_consents[#{index}][nurse_confirmed]",
                          "1", false,
                          id: "nurse_confirmed_#{template.id}",
                          class: "h-5 w-5 text-accent-primary focus:ring-accent-primary border-greige-300 rounded",
                          data: {
                            action: "change->consent-forms#checkNurseConfirmation",
                            consent_forms_target: "nurseCheckbox",
                            template_id: template.id
                          },
                          required: true %>
                    </div>
                    <div class="ml-3">
                      <label for="nurse_confirmed_<%= template.id %>" class="text-sm font-semibold text-greige-900 cursor-pointer">
                        看護師による最終確認 <span class="text-red-500">*</span>
                      </label>
                      <p class="text-xs text-greige-600 mt-1">
                        患者様の署名内容を看護師が確認した場合にチェックしてください。<br>
                        このチェックがないと同意書を送信できません。
                      </p>
                    </div>
                  </div>
                </div>

                <!-- 施設情報（自動表示） -->
                <div class="bg-greige-100 rounded-lg p-3 text-sm text-greige-700">
                  <p class="font-semibold mb-2">施設情報（自動記録）</p>
                  <p><strong>施設名:</strong> <%= @medical_record.facility.name %></p>
                  <p><strong>住所:</strong> <%= @medical_record.facility.address %></p>
                  <p><strong>電話番号:</strong> <%= @medical_record.facility.phone %></p>
                  <p><strong>施術者:</strong> <%= current_user.company_name || current_user.email %></p>
                </div>
              </div>
            <% end %>
          </div>

          <!-- ボタン -->
          <div class="mt-6 flex flex-wrap gap-3 justify-between">
            <button
              type="button"
              data-action="click->consent-forms#goBackToStep1"
              class="px-6 py-3 border border-greige-300 rounded-md shadow-sm text-base font-medium text-greige-700 bg-white hover:bg-greige-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary transition-colors">
              ← 戻る
            </button>
            <%= f.submit '同意する',
                data: {
                  consent_forms_target: "submitButton",
                  action: "click->consent-forms#validateBeforeSubmit"
                },
                class: "px-6 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
          </div>
        <% end %>
      </div>
    </div>

  <% end %>
</div>
