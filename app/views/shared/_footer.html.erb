<footer class="bg-greige-50 border-t border-greige-200 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
      <!-- InkFolioロゴとコピーライト -->
      <div class="flex flex-col items-center md:items-start space-y-2">
        <%= image_tag 'inkfolio-logo.svg', alt: 'InkFolio', class: 'h-8 w-auto' %>
        <p class="text-sm text-greige-600">
          &copy; <%= Time.current.year %> InkFolio. All rights reserved.
        </p>
      </div>

      <!-- リンク -->
      <div class="flex space-x-6 text-sm">
        <%= link_to '利用規約', terms_path, class: 'text-greige-600 hover:text-accent-primary transition-colors' %>
        <%= link_to 'プライバシーポリシー', privacy_path, class: 'text-greige-600 hover:text-accent-primary transition-colors' %>
        <% if user_signed_in? %>
          <%= link_to 'お問い合わせ', inquiries_path, class: 'text-greige-600 hover:text-accent-primary transition-colors' %>
        <% end %>
      </div>
    </div>
  </div>
</footer>
