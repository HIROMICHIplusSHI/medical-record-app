<header class="bg-blue-600 text-white" data-controller="header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between" style="min-height: 64px;">
      <!-- ロゴ/アプリ名 -->
      <div class="flex items-center">
        <%= link_to dynamic_root_path, class: "text-xl font-bold" do %>
          電子カルテ
        <% end %>
      </div>

      <!-- デスクトップナビゲーション（md以上で表示） -->
      <nav class="hidden md:flex items-center space-x-1" role="navigation">
        <% if current_user.admin? %>
          <%= link_to_nav_item('ダッシュボード', admin_root_path) %>
          <%= link_to_nav_item('ユーザー管理', admin_users_path) %>
          <%= link_to_nav_item('お知らせ管理', admin_announcements_path) %>
        <% else %>
          <%= link_to_nav_item('ダッシュボード', dashboard_path) %>
          <%= link_to_nav_item('カルテ', medical_records_path) %>
          <%= link_to_nav_item('患者', patients_path) %>
          <%= link_to_nav_item('施術場所', facilities_path) %>
          <%= link_to_nav_item('コストシート', cost_sheets_path) %>
          <%= link_to_nav_item('同意書', consent_form_templates_path) %>
          <%= link_to_nav_item('請求書', invoices_path) %>
        <% end %>
      </nav>

      <!-- 右側：ユーザーメニュー + ハンバーガー -->
      <div class="flex items-center space-x-2">
        <!-- ユーザードロップダウン -->
        <div class="relative" data-controller="dropdown">
          <button
            type="button"
            data-action="click->dropdown#toggle click@window->dropdown#hide"
            class="flex items-center space-x-1 p-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-white"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span class="hidden md:inline text-sm"><%= current_user.email.split('@').first %></span>
            <svg class="h-4 w-4 hidden md:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <!-- ドロップダウンメニュー -->
          <div
            data-dropdown-target="menu"
            class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50"
          >
            <%= link_to mypage_path, class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' do %>
              マイページ設定
            <% end %>
            <%= link_to destroy_user_session_path, method: :delete, data: { turbo_method: :delete }, class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' do %>
              ログアウト
            <% end %>
          </div>
        </div>

        <!-- ハンバーガーメニューボタン（mdより小さい画面で表示） -->
        <button
          type="button"
          data-action="click->header#toggleMobileMenu"
          class="md:hidden inline-flex items-center justify-center p-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-white"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- モバイルメニュー（mdより小さい画面で表示） -->
  <nav
    data-header-target="mobileMenu"
    class="md:hidden hidden bg-blue-700 bg-opacity-95"
    role="navigation"
  >
    <div class="px-2 pt-2 pb-3 space-y-1">
      <% if current_user.admin? %>
        <%= link_to_mobile_nav_item('ダッシュボード', admin_root_path) %>
        <%= link_to_mobile_nav_item('ユーザー管理', admin_users_path) %>
        <%= link_to_mobile_nav_item('お知らせ管理', admin_announcements_path) %>
      <% else %>
        <%= link_to_mobile_nav_item('ダッシュボード', dashboard_path) %>
        <%= link_to_mobile_nav_item('カルテ', medical_records_path) %>
        <%= link_to_mobile_nav_item('患者', patients_path) %>
        <%= link_to_mobile_nav_item('施術場所', facilities_path) %>
        <%= link_to_mobile_nav_item('コストシート', cost_sheets_path) %>
        <%= link_to_mobile_nav_item('同意書', consent_form_templates_path) %>
        <%= link_to_mobile_nav_item('請求書', invoices_path) %>
      <% end %>
    </div>
  </nav>
</header>
