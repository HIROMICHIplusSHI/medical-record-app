<header class="bg-white border-b border-greige-200 shadow-sm" data-controller="header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between" style="min-height: 64px;">
      <!-- InkFolioロゴ -->
      <div class="flex items-center">
        <%= link_to dynamic_root_path, class: "flex items-center" do %>
          <%= image_tag 'inkfolio-logo.svg', alt: 'InkFolio', class: 'h-14 w-auto' %>
        <% end %>
      </div>

      <!-- デスクトップナビゲーション（lg以上で表示） -->
      <nav class="hidden lg:flex items-center space-x-1" role="navigation">
        <% if current_user.admin? %>
          <% badge_count = unread_inquiry_count(current_user) %>
          <%= link_to_nav_item('ダッシュボード', admin_root_path) %>
          <%= link_to_nav_item('ユーザー管理', admin_users_path) %>
          <%= link_to_nav_item('招待コード管理', admin_invitation_codes_path) %>
          <%= link_to_nav_item('お知らせ管理', admin_announcements_path) %>
          <%= link_to admin_inquiries_path, class: "whitespace-nowrap px-3 py-2 rounded-md text-sm font-medium text-greige-700 hover:text-accent-primary transition-colors #{current_page?(admin_inquiries_path) ? 'bg-greige-100 text-accent-primary' : 'hover:bg-greige-100'}" do %>
            お問い合わせ
            <% if badge_count > 0 %>
              <span class="ml-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-accent-danger text-white" aria-label="<%= badge_count %>件の未対応お問い合わせ"><%= badge_count %></span>
            <% end %>
          <% end %>
        <% else %>
          <% user_badge_count = unread_inquiry_count(current_user) %>
          <%= link_to_nav_item('売上', revenue_dashboard_path) %>
          <%= link_to_nav_item('施術履歴', medical_records_path) %>
          <%= link_to_nav_item('患者', patients_path) %>
          <%= link_to_nav_item('施術場所', facilities_path) %>
          <%= link_to_nav_item('コストシート', cost_sheets_path) %>
          <%= link_to_nav_item('同意書', consent_form_templates_path) %>
          <%= link_to_nav_item('請求書', invoices_path) %>
          <%= link_to inquiries_path, class: "whitespace-nowrap px-3 py-2 rounded-md text-sm font-medium text-greige-700 hover:text-accent-primary transition-colors #{current_page?(inquiries_path) ? 'bg-greige-100 text-accent-primary' : 'hover:bg-greige-100'}" do %>
            お問い合わせ
            <% if user_badge_count > 0 %>
              <span class="ml-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-accent-danger text-white" aria-label="<%= user_badge_count %>件の未読お問い合わせ"><%= user_badge_count %></span>
            <% end %>
          <% end %>
        <% end %>
      </nav>

      <!-- 右側：ユーザーメニュー + ハンバーガー -->
      <div class="flex items-center space-x-2">
        <!-- ユーザードロップダウン -->
        <div class="relative" data-controller="dropdown">
          <button
            id="user-menu-button"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="user-menu"
            data-action="click->dropdown#toggle click@window->dropdown#hide"
            data-dropdown-target="button"
            class="flex items-center space-x-1 p-2 rounded-md text-greige-700 hover:bg-greige-100 focus:outline-none focus:ring-2 focus:ring-accent-primary"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span class="hidden md:inline text-sm"><%= current_user.email.split('@').first %></span>
            <svg class="h-4 w-4 hidden md:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <!-- ドロップダウンメニュー -->
          <div
            id="user-menu"
            role="menu"
            aria-labelledby="user-menu-button"
            data-dropdown-target="menu"
            class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50"
          >
            <%= link_to mypage_path, role: 'menuitem', class: 'block px-4 py-2 text-sm text-greige-700 hover:bg-greige-100 transition-colors' do %>
              マイページ設定
            <% end %>
            <%= link_to destroy_user_session_path, method: :delete, role: 'menuitem', data: { turbo_method: :delete }, class: 'block px-4 py-2 text-sm text-greige-700 hover:bg-greige-100 transition-colors' do %>
              ログアウト
            <% end %>
          </div>
        </div>

        <!-- ハンバーガーメニューボタン（lg未満＝スマホ・タブレットで表示） -->
        <button
          type="button"
          data-action="click->header#toggleMobileMenu"
          class="lg:hidden inline-flex items-center justify-center p-2 rounded-md text-greige-700 hover:bg-greige-100 focus:outline-none focus:ring-2 focus:ring-accent-primary"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- モバイルメニュー（lg未満＝スマホ・タブレットで表示） -->
  <nav
    data-header-target="mobileMenu"
    class="lg:hidden hidden bg-white border-t border-greige-200"
    role="navigation"
  >
    <div class="px-2 pt-2 pb-3 space-y-1">
      <% if current_user.admin? %>
        <% mobile_badge_count = unread_inquiry_count(current_user) %>
        <%= link_to_mobile_nav_item('ダッシュボード', admin_root_path) %>
        <%= link_to_mobile_nav_item('ユーザー管理', admin_users_path) %>
        <%= link_to_mobile_nav_item('招待コード管理', admin_invitation_codes_path) %>
        <%= link_to_mobile_nav_item('お知らせ管理', admin_announcements_path) %>
        <%= link_to admin_inquiries_path, class: "block px-3 py-2 rounded-md text-base font-medium text-greige-700 hover:text-accent-primary transition-colors #{current_page?(admin_inquiries_path) ? 'bg-greige-100 text-accent-primary' : 'hover:bg-greige-100'}" do %>
          お問い合わせ
          <% if mobile_badge_count > 0 %>
            <span class="ml-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-accent-danger text-white" aria-label="<%= mobile_badge_count %>件の未対応お問い合わせ">
              <%= mobile_badge_count %>
            </span>
          <% end %>
        <% end %>
      <% else %>
        <% mobile_user_badge_count = unread_inquiry_count(current_user) %>
        <%= link_to_mobile_nav_item('売上', revenue_dashboard_path) %>
        <%= link_to_mobile_nav_item('施術履歴', medical_records_path) %>
        <%= link_to_mobile_nav_item('患者', patients_path) %>
        <%= link_to_mobile_nav_item('施術場所', facilities_path) %>
        <%= link_to_mobile_nav_item('コストシート', cost_sheets_path) %>
        <%= link_to_mobile_nav_item('同意書', consent_form_templates_path) %>
        <%= link_to_mobile_nav_item('請求書', invoices_path) %>
        <%= link_to inquiries_path, class: "block px-3 py-2 rounded-md text-base font-medium text-greige-700 hover:text-accent-primary transition-colors #{current_page?(inquiries_path) ? 'bg-greige-100 text-accent-primary' : 'hover:bg-greige-100'}" do %>
          お問い合わせ
          <% if mobile_user_badge_count > 0 %>
            <span class="ml-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-accent-danger text-white" aria-label="<%= mobile_user_badge_count %>件の未読お問い合わせ">
              <%= mobile_user_badge_count %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </nav>
</header>
