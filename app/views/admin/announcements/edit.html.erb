<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= admin_breadcrumb ['お知らせ', admin_announcements_path], '編集' %>

  <!-- ヘッダー -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-greige-900">お知らせ編集</h1>
    <p class="mt-2 text-sm text-greige-600">お知らせの内容を編集します</p>
  </div>

  <!-- フォーム -->
  <div class="bg-white shadow-sm rounded-lg overflow-hidden">
    <div class="px-6 py-6">
      <%= render "form", announcement: @announcement %>
    </div>
  </div>
</div>
