<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">お知らせ管理</h1>
    <%= link_to "新規作成", new_admin_announcement_path, class: "btn btn-primary" %>
  </div>

  <!-- お知らせ一覧 -->
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <% if @announcements.any? %>
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>タイトル</th>
                <th>重要度</th>
                <th>ステータス</th>
                <th>公開日時</th>
                <th>作成者</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% @announcements.each do |announcement| %>
                <tr>
                  <td>
                    <%= link_to announcement.title, admin_announcement_path(announcement), class: "link link-primary" %>
                  </td>
                  <td>
                    <span class="badge <%= case announcement.severity
                      when 'info' then 'badge-info'
                      when 'warning' then 'badge-warning'
                      when 'critical' then 'badge-error'
                      end %>">
                      <%= announcement.severity_i18n %>
                    </span>
                  </td>
                  <td>
                    <span class="badge <%= case announcement.status
                      when 'draft' then 'badge-ghost'
                      when 'published' then 'badge-success'
                      when 'archived' then 'badge-neutral'
                      end %>">
                      <%= announcement.status_i18n %>
                    </span>
                  </td>
                  <td>
                    <%= announcement.published_at&.strftime('%Y/%m/%d %H:%M') || '-' %>
                  </td>
                  <td><%= announcement.author.email %></td>
                  <td>
                    <div class="flex gap-2">
                      <%= link_to "編集", edit_admin_announcement_path(announcement), class: "btn btn-sm btn-outline" %>
                      <% if announcement.draft? %>
                        <%= button_to "公開", publish_admin_announcement_path(announcement), method: :patch, class: "btn btn-sm btn-success" %>
                      <% end %>
                      <% if announcement.published? %>
                        <%= button_to "アーカイブ", archive_admin_announcement_path(announcement), method: :patch, class: "btn btn-sm btn-ghost" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- ページネーション -->
        <div class="mt-4">
          <%= paginate @announcements %>
        </div>
      <% else %>
        <p class="text-gray-500">お知らせがありません</p>
      <% end %>
    </div>
  </div>
</div>
