<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-greige-900">お問い合わせ管理</h1>
  </div>

  <div class="bg-white shadow-md rounded p-4 mb-6">
    <h3 class="font-semibold text-greige-900 mb-3">フィルター</h3>
    <%= form_with url: admin_inquiries_path, method: :get, local: true, class: 'flex gap-3 flex-wrap items-end' do |f| %>
      <div>
        <%= f.label :status, 'ステータス', class: 'block text-sm font-medium text-greige-700 mb-1' %>
        <%= f.select :status,
          options_for_select([
            ['全て', ''],
            ['未対応', 'open'],
            ['対応中', 'in_progress'],
            ['対応完了', 'closed']
          ], params[:status]),
          {},
          { class: 'rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary', data: { controller: 'tom-select' } } %>
      </div>
      <div>
        <%= f.label :category, 'カテゴリ', class: 'block text-sm font-medium text-greige-700 mb-1' %>
        <%= f.select :category,
          options_for_select([
            ['全て', '']
          ] + Inquiry.categories.keys.map { |key| [Inquiry.human_attribute_name("categories.#{key}"), key] },
          params[:category]),
          {},
          { class: 'rounded-md border-greige-300 shadow-sm focus:border-accent-primary focus:ring-accent-primary', data: { controller: 'tom-select' } } %>
      </div>
      <%= search_button 'フィルター' %>
    <% end %>
  </div>

  <% if @inquiries.any? %>
    <div class="bg-white shadow-md rounded">
      <table class="min-w-full">
        <thead class="bg-greige-50">
          <tr>
            <th class="px-3 py-3 text-center text-xs font-medium text-greige-500 uppercase tracking-wider w-16">未読</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">件名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">ユーザー</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">カテゴリ</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">ステータス</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">更新日時</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-greige-200">
          <% @inquiries.each do |inquiry| %>
            <tr>
              <td class="px-3 py-4 text-center">
                <%= unread_indicator_for(inquiry, current_user) %>
              </td>
              <td class="px-6 py-4">
                <%= link_to inquiry.subject, admin_inquiry_path(inquiry), class: "text-accent-primary hover:text-accent-primary/80 transition-colors" %>
              </td>
              <td class="px-6 py-4 text-sm text-greige-900">
                <%= inquiry.user.name %>
              </td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 text-xs font-medium rounded-full bg-greige-100 text-greige-800">
                  <%= inquiry.category_i18n %>
                </span>
              </td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= inquiry.open? ? 'bg-blue-100 text-blue-800' : inquiry.in_progress? ? 'bg-accent-warning/10 text-yellow-800' : 'bg-greige-100 text-greige-800' %>">
                  <%= inquiry.status_i18n %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-greige-500">
                <%= l(inquiry.updated_at, format: :short) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= show_button "表示", admin_inquiry_path(inquiry) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex justify-center">
      <%= paginate @inquiries %>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded p-8 text-center">
      <p class="text-greige-600 mb-2">
        <%= params[:status].present? || params[:category].present? ? '該当するお問い合わせはありません。' : 'まだお問い合わせはありません。' %>
      </p>
      <p class="text-greige-500 text-sm">
        <%= params[:status].present? || params[:category].present? ? 'フィルター条件を変更してください。' : 'ユーザーからのお問い合わせがここに表示されます。' %>
      </p>
    </div>
  <% end %>
</div>
