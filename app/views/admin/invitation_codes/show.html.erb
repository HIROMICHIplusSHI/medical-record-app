<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- ヘッダー -->
  <div class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-greige-900">招待コード詳細</h1>
    </div>
    <div class="flex gap-2">
      <%= edit_button "編集", edit_admin_invitation_code_path(@invitation_code) %>
      <%= back_button "一覧に戻る", admin_invitation_codes_path %>
    </div>
  </div>

  <!-- 招待コード詳細 -->
  <div class="bg-white shadow-sm rounded-lg overflow-hidden">
    <div class="px-6 py-6">
      <dl class="grid grid-cols-1 gap-y-6">
        <!-- コード -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <dt class="text-sm font-medium text-greige-500">コード</dt>
          <dd class="text-base text-greige-900 md:col-span-2 font-semibold"><%= @invitation_code.code %></dd>
        </div>

        <!-- ステータス -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <dt class="text-sm font-medium text-greige-500">ステータス</dt>
          <dd class="md:col-span-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @invitation_code.active? ? 'bg-accent-success/10 text-accent-success/90' : 'bg-greige-100 text-greige-600' %>">
              <%= I18n.t("activerecord.attributes.invitation_code.statuses.#{@invitation_code.status}") %>
            </span>
          </dd>
        </div>

        <!-- 使用状況 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <dt class="text-sm font-medium text-greige-500">使用状況</dt>
          <dd class="text-base text-greige-900 md:col-span-2">
            <%= @invitation_code.used_count %> / <%= @invitation_code.max_uses || '無制限' %>
          </dd>
        </div>

        <!-- 有効期限 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <dt class="text-sm font-medium text-greige-500">有効期限</dt>
          <dd class="text-base text-greige-900 md:col-span-2">
            <%= @invitation_code.expires_at ? l(@invitation_code.expires_at, format: :long) : '無期限' %>
          </dd>
        </div>

        <!-- メモ -->
        <% if @invitation_code.memo.present? %>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-greige-500">メモ</dt>
            <dd class="text-base text-greige-900 md:col-span-2 whitespace-pre-wrap"><%= @invitation_code.memo %></dd>
          </div>
        <% end %>

        <!-- 作成者 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <dt class="text-sm font-medium text-greige-500">作成者</dt>
          <dd class="text-base text-greige-900 md:col-span-2 break-all"><%= @invitation_code.created_by.email %></dd>
        </div>

        <!-- 作成日時 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <dt class="text-sm font-medium text-greige-500">作成日時</dt>
          <dd class="text-base text-greige-900 md:col-span-2"><%= l(@invitation_code.created_at, format: :long) %></dd>
        </div>
      </dl>

      <!-- 区切り線 -->
      <div class="mt-8 pt-6 border-t border-greige-200">
        <h3 class="text-sm font-medium text-greige-900 mb-3">操作</h3>
        <div class="flex gap-2">
          <% if @invitation_code.active? %>
            <%= button_to "停止する", suspend_admin_invitation_code_path(@invitation_code), method: :patch, class: "inline-flex items-center justify-center px-4 py-2 border border-greige-300 rounded-md shadow-sm text-sm font-medium text-greige-700 bg-white hover:bg-greige-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary transition-colors duration-200 transition-colors" %>
          <% else %>
            <%= button_to "有効化する", activate_admin_invitation_code_path(@invitation_code), method: :patch, class: "inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors duration-200" %>
          <% end %>
          <%= button_to "削除する", admin_invitation_code_path(@invitation_code), method: :delete, form: { data: { turbo_confirm: '本当に削除してよろしいですか？' } }, class: "inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors duration-200" %>
        </div>
      </div>
    </div>
  </div>
</div>
