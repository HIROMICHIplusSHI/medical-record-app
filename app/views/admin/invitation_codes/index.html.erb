<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- ヘッダー -->
  <div class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-greige-900">招待コード管理</h1>
      <p class="mt-2 text-sm text-greige-600">招待コードの作成と管理</p>
    </div>
    <div class="flex gap-2">
      <%= link_to "CSV出力", export_admin_invitation_codes_path(format: :csv), class: "inline-flex items-center px-4 py-2 border border-greige-300 rounded-md text-sm font-medium text-greige-700 bg-white hover:bg-greige-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary transition-colors" %>
      <%= new_button "新規作成", new_admin_invitation_code_path %>
    </div>
  </div>

  <!-- 検索フォーム -->
  <div class="bg-white shadow-sm rounded-lg overflow-hidden mb-6 p-6">
    <%= search_form_for @q, url: admin_invitation_codes_path, method: :get, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :code_cont, "コード", class: "block text-sm font-medium text-greige-700 mb-2" %>
          <%= f.search_field :code_cont, class: "appearance-none block w-full px-3 py-2 border border-greige-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-accent-primary focus:border-accent-primary sm:text-sm", placeholder: "検索..." %>
        </div>
        <div>
          <%= f.label :status_eq, "ステータス", class: "block text-sm font-medium text-greige-700 mb-2" %>
          <%= f.select :status_eq, options_for_select([[I18n.t('activerecord.attributes.invitation_code.statuses.active'), 'active'], [I18n.t('activerecord.attributes.invitation_code.statuses.inactive'), 'inactive']], f.object.status_eq), { include_blank: "すべて" }, class: "appearance-none block w-full px-3 py-2 border border-greige-300 rounded-md shadow-sm focus:outline-none focus:ring-accent-primary focus:border-accent-primary sm:text-sm" %>
        </div>
      </div>
      <div class="flex gap-2">
        <%= search_button "検索" %>
        <%= clear_button "クリア", admin_invitation_codes_path %>
      </div>
    <% end %>
  </div>

  <!-- 招待コード一覧 -->
  <div class="bg-white shadow-sm rounded-lg overflow-hidden">
    <% if @invitation_codes.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-greige-200" role="table" aria-label="招待コード一覧">
          <caption class="sr-only">招待コード管理テーブル</caption>
          <thead class="bg-greige-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">
                コード
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">
                ステータス
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">
                使用状況
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">
                有効期限
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-greige-500 uppercase tracking-wider">
                作成者
              </th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-greige-500 uppercase tracking-wider">
                操作
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-greige-200">
            <% @invitation_codes.each do |code| %>
              <tr class="hover:bg-greige-50">
                <td class="px-6 py-4">
                  <%= link_to code.code, admin_invitation_code_path(code), class: "text-sm text-accent-primary hover:text-accent-primary/90 transition-colors font-medium" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= code.active? ? 'bg-accent-success/10 text-accent-success/90' : 'bg-greige-100 text-greige-600' %>">
                    <%= I18n.t("activerecord.attributes.invitation_code.statuses.#{code.status}") %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-greige-900">
                  <%= code.used_count %> / <%= code.max_uses || '無制限' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-greige-500">
                  <%= code.expires_at ? l(code.expires_at, format: :long) : '無期限' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-greige-900">
                  <%= code.created_by.email %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex gap-2 justify-end">
                    <%= show_button "詳細", admin_invitation_code_path(code) %>
                    <%= edit_button "編集", edit_admin_invitation_code_path(code) %>
                    <% if code.active? %>
                      <%= button_to "停止", suspend_admin_invitation_code_path(code), method: :patch, class: "inline-flex items-center px-3 py-1 border border-greige-300 rounded-md text-sm font-medium text-greige-700 bg-white hover:bg-greige-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-primary transition-colors" %>
                    <% else %>
                      <%= button_to "有効化", activate_admin_invitation_code_path(code), method: :patch, class: "inline-flex items-center px-3 py-1 border border-transparent rounded-md text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
                    <% end %>
                    <%= delete_button "削除", admin_invitation_code_path(code) %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- ページネーション -->
      <div class="px-6 py-4 bg-greige-50 border-t border-greige-200">
        <%= paginate @invitation_codes %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <p class="text-sm text-greige-500">招待コードがありません</p>
      </div>
    <% end %>
  </div>
</div>
