<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= admin_breadcrumb ['招待コード', admin_invitation_codes_path], '編集' %>

  <!-- ヘッダー -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-greige-900">招待コード編集</h1>
    <p class="mt-2 text-sm text-greige-600">招待コードの内容を編集します</p>
  </div>

  <!-- フォーム -->
  <div class="bg-white shadow-sm rounded-lg overflow-hidden">
    <div class="px-6 py-6">
      <%= render "form", invitation_code: @invitation_code %>
    </div>
  </div>
</div>
